# Copy to .env and fill in. .env is gitignored.

# Optional: higher GitHub API rate limit for the GitHub section.
GITHUB_TOKEN=

# Spotify section. Client ID and secret come from
# https://developer.spotify.com/dashboard (your app > Settings).
# Get the refresh token with: npm run spotify:token
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
