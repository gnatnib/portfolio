---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { resumeUrl, resume, facts } from "../data";

// Pages are shown as images: browser PDF plugins, download managers and most
// mobile browsers leave an embedded PDF blank. scripts/render-cv.py writes them.
const pages = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/cv/page-*.png", { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b, "en", { numeric: true }))
  .map(([, mod]) => mod.default);
---

<Base
  title="Resume, Bintang Syafrian Rizal"
  description="Curriculum vitae of Bintang Syafrian Rizal: Computer Science at Universitas Diponegoro, full-stack and machine learning work."
>
  <section class="sec wrap rs" data-tone="light" data-label="Resume">
    <header class="sec-head">
      <p class="sec-index mono"><a href="/" class="ul">Index</a> / Resume</p>
      <h1 class="sec-title" data-reveal="lines">Resume</h1>
    </header>

    <div class="rs-body">
      <aside class="rs-side">
        <dl>
          {
            facts.map((f) => (
              <div>
                <dt class="mono muted">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="rs-links">
          <a href={resumeUrl} download={resume.downloadName} class="ul ul-on">Download PDF</a>
          <a href={resumeUrl} target="_blank" rel="noopener" class="ul">Open in a tab <span class="arrow">↗</span></a>
        </p>
        <p class="mono muted">Version {resume.version}</p>
      </aside>

      <div class="rs-pages">
        {
          pages.map((p, i) => (
            <Image
              src={p}
              alt={`Resume, page ${i + 1} of ${pages.length}`}
              widths={[640, 960, 1280, 1429]}
              sizes="(max-width: 860px) 92vw, 62vw"
              loading={i === 0 ? "eager" : "lazy"}
              id={`page-${i + 1}`}
              data-reveal="fade"
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .rs {
    padding-bottom: 120px;
  }
  .rs-body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding-top: 40px;
  }
  .rs-side {
    grid-column: 1 / span 3;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    align-self: start;
    display: grid;
    gap: 24px;
  }
  .rs-side dl div {
    border-top: 1px solid var(--rule-strong);
    padding-block: 10px 14px;
  }
  .rs-side dd {
    margin-top: 6px;
  }
  .rs-links {
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .rs-pages {
    grid-column: 4 / span 9;
    display: grid;
    gap: 24px;
  }
  .rs-pages img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    background: #fff;
  }
  @media (max-width: 860px) {
    .rs-side,
    .rs-pages {
      grid-column: 1 / -1;
      position: static;
    }
    .rs-pages {
      margin-top: 32px;
    }
  }
</style>

<script>
  import "../scripts/motion";
</script>
