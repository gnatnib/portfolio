---
/* Easter egg: a typing test played on the footer wordmark. A quest marker
   floats in the corner once the hero is behind you, and the footer cat carries
   one over its head; either starts the quest. The ASCII "gnatnib" dims into a
   backdrop while you type, then re-forms as your score. Mounted inside the
   footer's playground (Contact.astro), over the doodle canvas. */
const rows = ["qwertyuiop", "asdfghjkl", "zxcvbnm"];
---

<button type="button" class="qm mono" data-quest-marker aria-label="A quest is available: start the typing test" hidden>
  <span class="qm-bang" aria-hidden="true">!</span>
  <span class="qm-label">Quest</span>
</button>

<div class="tq mono" data-quest hidden>
  <div class="tq-bar">
    <span class="tq-title"><b>!</b> Quest: type fast</span>
    <span class="tq-modes" role="group" aria-label="Duration">
      {
        [15, 30, 60].map((s) => (
          <button type="button" data-mode={s} aria-pressed={s === 30 ? "true" : "false"}>
            {s}s
          </button>
        ))
      }
    </span>
    <button type="button" class="tq-btn" data-quest-close>Exit (Esc)</button>
  </div>

  <div class="tq-stats">
    <div><span class="muted">Time</span><b class="num" data-stat="time">30</b></div>
    <div><span class="muted">WPM</span><b class="num" data-stat="wpm">0</b></div>
    <div><span class="muted">Accuracy</span><b class="num" data-stat="acc">100%</b></div>
    <div><span class="muted">Best</span><b class="num" data-stat="best">-</b></div>
  </div>

  <div class="tq-play" data-play>
    <div class="tq-words" data-words aria-hidden="true">
      <div class="tq-track" data-track></div>
      <span class="tq-caret" data-caret></span>
    </div>
    <p class="tq-hint muted" data-hint>Start typing. Space moves to the next word. Tab restarts.</p>
    <input
      class="tq-input"
      data-input
      type="text"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      aria-label="Type the words shown"
    />
    <div class="tq-kb" aria-hidden="true" data-kb>
      {
        rows.map((r, i) => (
          <div class="tq-row" style={`--indent:${i * 0.5}`}>
            {[...r].map((k) => (
              <span class="tq-key" data-key={k}>
                {k}
              </span>
            ))}
          </div>
        ))
      }
      <div class="tq-row">
        <span class="tq-key tq-space" data-key=" ">space</span>
      </div>
    </div>
  </div>

  <div class="tq-result" data-result hidden>
    <p class="tq-rank"><b data-r="rank"></b> <span class="muted" data-r="best"></span></p>
    <dl class="tq-numbers">
      <div><dt class="muted">Accuracy</dt><dd class="num" data-r="acc"></dd></div>
      <div><dt class="muted">Raw</dt><dd class="num" data-r="raw"></dd></div>
      <div><dt class="muted">Correct / wrong / extra</dt><dd class="num" data-r="chars"></dd></div>
      <div><dt class="muted">WPM each second</dt><dd class="tq-spark" data-r="spark"></dd></div>
    </dl>
    <p class="tq-again">
      <button type="button" class="tq-btn" data-again>Try again (Tab)</button>
    </p>
  </div>
  <p class="sr-only" aria-live="polite" data-announce></p>
</div>

<style>
  /* Marker: a bobbing exclamation, like a quest giver in an RPG. */
  .qm {
    position: fixed;
    right: var(--pad);
    bottom: 20px;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 8px;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid var(--accent);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: transform 0.3s var(--ease);
  }
  .qm[hidden] {
    display: none;
  }
  .qm:hover {
    transform: translateY(-2px);
  }
  .qm-bang {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    background: var(--accent);
    color: var(--ink);
    font-weight: 700;
    font-size: 15px;
    animation: qm-bob 1.1s ease-in-out infinite;
  }
  @keyframes qm-bob {
    50% {
      transform: translateY(-3px);
    }
  }

  /* The quest sits on top of the dimmed wordmark; no box of its own, just
     hairlines, so the ASCII still reads as the stage underneath. */
  .tq {
    position: relative;
    z-index: 1;
  }
  .tq[hidden] {
    display: none;
  }
  .tq-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    font-size: 12px;
    text-transform: uppercase;
  }
  .tq-title b {
    color: var(--accent);
  }
  .tq-modes {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .tq-modes button,
  .tq-btn {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 11px;
    text-transform: uppercase;
    background: var(--bg);
  }
  .tq-modes button[aria-pressed="true"] {
    background: var(--fg);
    color: var(--bg);
  }
  .tq-btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .tq-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--rule);
  }
  .tq-stats div {
    display: grid;
    gap: 2px;
    padding: 10px 0;
    font-size: 11px;
    text-transform: uppercase;
  }
  .tq-stats b {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .tq-stats [data-stat="time"] {
    color: var(--accent);
  }

  .tq-play {
    position: relative;
    padding-top: 22px;
  }
  .tq-play[hidden] {
    display: none;
  }
  /* Three lines of words; the track slides up as lines are finished. */
  .tq-words {
    position: relative;
    height: calc(3 * 1.7em);
    overflow: hidden;
    font-size: clamp(18px, 2.4vw, 28px);
    line-height: 1.7;
    cursor: text;
    text-transform: none;
    letter-spacing: 0;
  }
  .tq-track {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.6em;
    transition: transform 0.25s var(--ease);
  }
  .tq-track :global(.w) {
    color: var(--muted);
  }
  .tq-track :global(.w .ok) {
    color: var(--fg);
  }
  .tq-track :global(.w .bad) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tq-track :global(.w .extra) {
    color: var(--accent);
    opacity: 0.6;
  }
  .tq-track :global(.w.miss) {
    text-decoration: underline wavy var(--accent);
    text-underline-offset: 6px;
  }
  .tq-caret {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 1.2em;
    background: var(--accent);
    transition: transform 0.08s linear;
    animation: tq-blink 1s steps(1) infinite;
  }
  .tq-caret.is-typing {
    animation: none;
  }
  @keyframes tq-blink {
    50% {
      opacity: 0;
    }
  }
  .tq-hint {
    font-size: 11px;
    padding-top: 10px;
  }
  /* The real input covers the words, invisible, so phones raise their keyboard. */
  .tq-input {
    position: absolute;
    inset: 0 0 auto;
    height: calc(22px + 3 * 1.7 * clamp(18px, 2.4vw, 28px));
    opacity: 0;
    width: 100%;
    cursor: text;
  }

  .tq-kb {
    display: grid;
    gap: 6px;
    justify-items: center;
    padding: 18px 0 8px;
  }
  .tq-row {
    display: flex;
    gap: 6px;
    padding-left: calc(var(--indent, 0) * 22px);
  }
  .tq-key {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--rule-strong);
    background: var(--bg);
    font-size: 13px;
    text-transform: uppercase;
    color: var(--muted);
    transition:
      background-color 0.18s var(--ease),
      color 0.18s var(--ease),
      transform 0.12s var(--ease);
  }
  .tq-space {
    width: 280px;
    font-size: 10px;
  }
  .tq-key.is-next {
    border-color: var(--fg);
    color: var(--fg);
  }
  .tq-key.is-down {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
    transform: translateY(2px);
  }
  .tq-key.is-wrong {
    background: var(--fg);
    color: var(--bg);
  }

  /* Results ride above the canvas, which now spells the score in ASCII. */
  .tq-result {
    display: grid;
    gap: 12px;
    padding-top: 14px;
  }
  .tq-result[hidden] {
    display: none;
  }
  .tq-rank {
    font-size: 12px;
    text-transform: uppercase;
  }
  .tq-rank b {
    color: var(--accent);
    font-weight: 500;
  }
  .tq-numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }
  .tq-numbers div {
    display: grid;
    gap: 2px;
  }
  .tq-numbers dt {
    font-size: 11px;
    text-transform: uppercase;
  }
  .tq-numbers dd {
    font-size: 18px;
  }
  .tq-spark {
    letter-spacing: 0.15em;
    white-space: pre;
  }

  @media (max-width: 720px) {
    .tq-title {
      display: none;
    }
    .tq-modes {
      margin-left: 0;
    }
    .tq-btn {
      margin-left: auto;
    }
    .tq-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Phones bring their own keyboard. */
    .tq-kb {
      display: none;
    }
    .qm-label {
      display: none;
    }
  }
</style>

<script>
  import { lenis, reduced } from "../scripts/motion";

  const WORDS = (
    "the of and to in is you that it he was for on are as with his they at be this have from or one had by word but not what all were we when your can said there use an each which she do how their if will up other about out many then them these so some her would make like him into time has look two more write go see number no way could people my than first water been call who oil its now find long down day did get come made may part " +
    "code build ship model data train deploy query table merge commit branch review test debug stack cache loop array string index vector token layer graph node edge server client route state input output signal pixel frame batch epoch tensor kernel shell script parse render design system logic engine workflow approval capture"
  ).split(" ");

  const RANKS: [number, string][] = [
    [90, "Legend"],
    [70, "Wizard"],
    [50, "Knight"],
    [30, "Adept"],
    [0, "Novice"],
  ];
  const SPARK = " .:-=+*#%@";

  const quest = document.querySelector<HTMLElement>("[data-quest]")!;
  const play = document.querySelector<HTMLElement>("[data-doodle]")!;
  const marker = document.querySelector<HTMLButtonElement>("[data-quest-marker]")!;
  const track = quest.querySelector<HTMLElement>("[data-track]")!;
  const words = quest.querySelector<HTMLElement>("[data-words]")!;
  const caret = quest.querySelector<HTMLElement>("[data-caret]")!;
  const input = quest.querySelector<HTMLInputElement>("[data-input]")!;
  const playArea = quest.querySelector<HTMLElement>("[data-play]")!;
  const result = quest.querySelector<HTMLElement>("[data-result]")!;
  const hint = quest.querySelector<HTMLElement>("[data-hint]")!;
  const announce = quest.querySelector<HTMLElement>("[data-announce]")!;
  const stat = (k: string) => quest.querySelector<HTMLElement>(`[data-stat="${k}"]`)!;
  const out = (k: string) => quest.querySelector<HTMLElement>(`[data-r="${k}"]`)!;
  const keys = new Map([...quest.querySelectorAll<HTMLElement>("[data-key]")].map((k) => [k.dataset.key!, k]));
  const modes = [...quest.querySelectorAll<HTMLButtonElement>("[data-mode]")];

  const word = (text: string) => window.dispatchEvent(new CustomEvent("doodle:word", { detail: { text } }));
  const dim = (on: boolean) => window.dispatchEvent(new CustomEvent("doodle:dim", { detail: { on } }));

  /* An original alert sting, made on the spot with Web Audio: a noise hit and
     two stacked brassy tones that jump up a fifth. Only ever played from a click. */
  let audio: AudioContext | null = null;
  const sting = () => {
    try {
      audio ??= new AudioContext();
      const ctx = audio;
      const now = ctx.currentTime;
      const master = ctx.createGain();
      master.gain.value = 0.22;
      master.connect(ctx.destination);

      const noise = ctx.createBuffer(1, ctx.sampleRate * 0.12, ctx.sampleRate);
      const ch = noise.getChannelData(0);
      for (let i = 0; i < ch.length; i++) ch[i] = (Math.random() * 2 - 1) * (1 - i / ch.length) ** 3;
      const hit = ctx.createBufferSource();
      hit.buffer = noise;
      const hitGain = ctx.createGain();
      hitGain.gain.value = 0.7;
      hit.connect(hitGain).connect(master);
      hit.start(now);

      [
        { f: 233, t: 0, d: 0.16 },
        { f: 349, t: 0.09, d: 0.5 },
      ].forEach(({ f, t, d }) => {
        const filter = ctx.createBiquadFilter();
        filter.type = "lowpass";
        filter.frequency.setValueAtTime(600, now + t);
        filter.frequency.exponentialRampToValueAtTime(4200, now + t + 0.04);
        filter.frequency.exponentialRampToValueAtTime(900, now + t + d);
        const env = ctx.createGain();
        env.gain.setValueAtTime(0.0001, now + t);
        env.gain.exponentialRampToValueAtTime(1, now + t + 0.015);
        env.gain.exponentialRampToValueAtTime(0.0001, now + t + d);
        filter.connect(env).connect(master);
        [0, 7, -5].forEach((cents) => {
          const o = ctx.createOscillator();
          o.type = "sawtooth";
          o.frequency.value = f;
          o.detune.value = cents;
          o.connect(filter);
          o.start(now + t);
          o.stop(now + t + d + 0.05);
        });
      });
    } catch {
      // No audio device or a blocked context: the quest works silently.
    }
  };

  let seconds = 30;
  let list: string[] = [];
  let typed: string[] = [];
  let wi = 0;
  let started = 0;
  let ended = false;
  let timer = 0;
  let keystrokes = 0;
  let wrongStrokes = 0;
  let history: number[] = [];
  let active = false;

  const bestKey = () => `tq-best-${seconds}`;
  const best = () => Number(localStorage.getItem(bestKey()) || 0);
  const pick = () => WORDS[(Math.random() * WORDS.length) | 0];

  const renderWord = (i: number) => {
    const el = track.children[i] as HTMLElement;
    const target = list[i];
    const got = typed[i] ?? "";
    el.replaceChildren(
      ...[...target].map((c, k) => {
        const s = document.createElement("span");
        s.textContent = c;
        if (k < got.length) s.className = got[k] === c ? "ok" : "bad";
        return s;
      }),
      ...[...got.slice(target.length)].map((c) => Object.assign(document.createElement("span"), { textContent: c, className: "extra" })),
    );
    el.classList.toggle("miss", i < wi && got !== target);
  };

  const fill = (n: number) => {
    for (let i = 0; i < n; i++) {
      list.push(pick());
      const w = document.createElement("span");
      w.className = "w";
      track.append(w);
      renderWord(list.length - 1);
    }
  };

  /** Caret to the next character; the track scrolls so the current line is the second. */
  const place = () => {
    const w = track.children[wi] as HTMLElement;
    const at = (typed[wi] ?? "").length;
    const chars = w.children;
    // Char offsets are against the words box (the nearest positioned parent)
    // and ignore the track's transform.
    const ref = chars[Math.min(at, chars.length - 1)] as HTMLElement;
    const x = ref.offsetLeft + (at >= chars.length ? ref.offsetWidth : 0);
    const lineH = parseFloat(getComputedStyle(words).lineHeight);
    const shift = Math.max(0, w.offsetTop - lineH);
    track.style.transform = `translateY(${-shift}px)`;
    caret.style.transform = `translate(${x}px, ${w.offsetTop - shift + lineH * 0.25}px)`;
    const next = at < list[wi].length ? list[wi][at] : " ";
    keys.forEach((k, c) => k.classList.toggle("is-next", c === next.toLowerCase()));
  };

  const counts = () => {
    let correct = 0;
    let incorrect = 0;
    let extra = 0;
    for (let i = 0; i <= wi && i < list.length; i++) {
      const w = list[i];
      const t = typed[i] ?? "";
      for (let k = 0; k < t.length; k++) {
        if (k >= w.length) extra++;
        else if (t[k] === w[k]) correct++;
        else incorrect++;
      }
      // A finished, fully correct word earns its space.
      if (i < wi && t === w) correct++;
    }
    return { correct, incorrect, extra };
  };
  const elapsed = () => (started ? Math.min(seconds, (performance.now() - started) / 1000) : 0);
  // At least one second in the denominator, so the first keystrokes do not read as 1000 wpm.
  const wpm = (chars: number, s: number) => (s > 0 ? Math.round(chars / 5 / (Math.max(1, s) / 60)) : 0);
  const accuracy = () => (keystrokes ? Math.round(((keystrokes - wrongStrokes) / keystrokes) * 100) : 100);

  const tickStats = () => {
    const s = elapsed();
    stat("time").textContent = String(Math.ceil(seconds - s));
    stat("wpm").textContent = String(wpm(counts().correct, s));
    stat("acc").textContent = `${accuracy()}%`;
  };

  const reset = () => {
    clearInterval(timer);
    list = [];
    typed = [""];
    wi = 0;
    started = 0;
    ended = false;
    keystrokes = 0;
    wrongStrokes = 0;
    history = [];
    track.replaceChildren();
    fill(80);
    playArea.hidden = false;
    result.hidden = true;
    hint.hidden = false;
    input.value = "";
    caret.classList.remove("is-typing");
    play.classList.add("is-questing");
    word("gnatnib");
    dim(true);
    stat("best").textContent = best() ? String(best()) : "-";
    tickStats();
    requestAnimationFrame(place);
    input.focus({ preventScroll: true });
  };

  const finish = () => {
    ended = true;
    clearInterval(timer);
    const c = counts();
    const w = wpm(c.correct, seconds);
    const isBest = w > best();
    if (isBest) localStorage.setItem(bestKey(), String(w));
    const rank = RANKS.find(([min]) => w >= min)![1];
    out("rank").textContent = `Quest complete: ${rank}`;
    out("best").textContent = isBest ? "new best" : `best ${best()}`;
    out("acc").textContent = `${accuracy()}%`;
    out("raw").textContent = String(wpm(c.correct + c.incorrect + c.extra, seconds));
    out("chars").textContent = `${c.correct} / ${c.incorrect} / ${c.extra}`;
    const peak = Math.max(1, ...history);
    out("spark").textContent = history.map((v) => SPARK[Math.round((v / peak) * (SPARK.length - 1))]).join("");
    playArea.hidden = true;
    result.hidden = false;
    stat("best").textContent = String(best());
    // The wordmark re-forms as the score.
    play.classList.remove("is-questing");
    dim(false);
    word(`${w} wpm`);
    announce.textContent = `${w} words per minute, ${accuracy()} percent accuracy. Rank: ${rank}.`;
    quest.querySelector<HTMLButtonElement>("[data-again]")!.focus({ preventScroll: true });
  };

  const start = () => {
    started = performance.now();
    hint.hidden = true;
    caret.classList.add("is-typing");
    timer = window.setInterval(() => {
      const s = elapsed();
      history.push(wpm(counts().correct, s));
      tickStats();
      if (s >= seconds) finish();
    }, 1000);
  };

  const flash = (key: string, wrong: boolean) => {
    const k = keys.get(key.toLowerCase());
    if (!k) return;
    k.classList.add("is-down");
    k.classList.toggle("is-wrong", wrong);
    setTimeout(() => k.classList.remove("is-down", "is-wrong"), 140);
  };

  // Typing goes through the hidden input, so desktop keys and phone keyboards share one path.
  input.addEventListener("keydown", (e) => {
    if (e.key === "Tab") {
      e.preventDefault();
      reset();
      return;
    }
    if (e.key === "Escape") {
      close();
      return;
    }
    if (ended) return;
    if (e.key === "Backspace") {
      e.preventDefault();
      typed[wi] = (typed[wi] ?? "").slice(0, -1);
      renderWord(wi);
      place();
      return;
    }
    if (e.key === " ") {
      e.preventDefault();
      if (!(typed[wi] ?? "").length) return;
      if (!started) start();
      keystrokes++;
      if (typed[wi] !== list[wi]) wrongStrokes++;
      flash(" ", typed[wi] !== list[wi]);
      wi++;
      typed[wi] = "";
      renderWord(wi - 1);
      if (list.length - wi < 30) fill(40);
      place();
      tickStats();
      return;
    }
    if (e.key.length !== 1 || e.ctrlKey || e.metaKey || e.altKey) return;
    e.preventDefault();
    if (!started) start();
    const wrong = e.key !== list[wi][(typed[wi] ?? "").length];
    keystrokes++;
    if (wrong) wrongStrokes++;
    typed[wi] = (typed[wi] ?? "") + e.key;
    flash(e.key, wrong);
    renderWord(wi);
    place();
    tickStats();
  });
  // Phone keyboards often skip keydown details; read what landed in the input instead.
  input.addEventListener("input", () => {
    const v = input.value;
    input.value = "";
    for (const ch of v) input.dispatchEvent(new KeyboardEvent("keydown", { key: ch }));
  });

  words.addEventListener("click", () => input.focus({ preventScroll: true }));
  modes.forEach((b) =>
    b.addEventListener("click", () => {
      seconds = Number(b.dataset.mode);
      modes.forEach((m) => m.setAttribute("aria-pressed", String(m === b)));
      reset();
    }),
  );
  quest.querySelector("[data-again]")!.addEventListener("click", reset);
  quest.addEventListener("keydown", (e) => {
    if (e.target === input) return;
    if (e.key === "Tab" && ended) {
      e.preventDefault();
      reset();
    }
    if (e.key === "Escape") close();
  });

  function close() {
    if (!active) return;
    active = false;
    clearInterval(timer);
    quest.hidden = true;
    play.classList.remove("is-questing");
    dim(false);
    word("gnatnib");
    syncMarker();
  }
  quest.querySelector("[data-quest-close]")!.addEventListener("click", close);

  const open = () => {
    sting();
    if (!active) {
      active = true;
      quest.hidden = false;
      reset();
    }
    syncMarker();
    // Bring the footer into view with the quest at the top of the screen.
    const top = quest.getBoundingClientRect().top + scrollY - 80;
    if (lenis) lenis.scrollTo(top, { duration: 1.2 });
    else scrollTo({ top });
    setTimeout(() => input.focus({ preventScroll: true }), reduced ? 0 : 900);
  };
  marker.addEventListener("click", open);
  window.addEventListener("quest:open", open);
  window.addEventListener("resize", () => active && !ended && place());

  // The marker shows once the hero is mostly behind the reader, and hides at
  // the footer, where the cat carries its own.
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  let pastHero = false;
  let atFooter = false;
  function syncMarker() {
    marker.hidden = active || !pastHero || atFooter;
  }
  if (hero)
    new IntersectionObserver(([e]) => ((pastHero = e.intersectionRatio < 0.25), syncMarker()), {
      threshold: [0, 0.25],
    }).observe(hero);
  new IntersectionObserver(([e]) => ((atFooter = e.isIntersecting), syncMarker())).observe(play);
  if (reduced) marker.querySelector<HTMLElement>(".qm-bang")!.style.animation = "none";
</script>
