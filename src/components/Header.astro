---
const links = [
  { href: "/#work", label: "Work" },
  { href: "/#about", label: "About" },
  { href: "/#experience", label: "Experience" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="hdr" data-header>
  <a href="/" class="hdr-mark" aria-label="Bintang Syafrian Rizal, home">
    <span class="hdr-sq" aria-hidden="true"></span>gnatnib
  </a>
  <p class="hdr-now mono" aria-live="off">
    <span data-section-label>Index</span>
  </p>
  <nav class="hdr-nav" aria-label="Main">
    {links.map((l) => <a href={l.href} class="ul">{l.label}</a>)}
    <a href="/resume" class="ul">Resume</a>
  </nav>
  <button class="hdr-menu mono" aria-expanded="false" aria-controls="menu" data-menu-toggle>
    <span data-menu-label>Menu</span>
  </button>
</header>

<div class="menu" id="menu" hidden data-menu>
  <nav aria-label="Mobile">
    <ol>
      {
        [...links, { href: "/resume", label: "Resume" }].map((l, i) => (
          <li>
            <a href={l.href} data-menu-link>
              <span class="mono muted">{String(i + 1).padStart(2, "0")}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <p class="mono muted menu-foot">bintang.syafrian@gmail.com</p>
</div>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: var(--pad);
    color: #fff;
    mix-blend-mode: difference;
    font-size: 14px;
  }
  .hdr-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    justify-self: start;
  }
  .hdr-sq {
    width: 10px;
    height: 10px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  .hdr-mark:hover .hdr-sq {
    transform: rotate(90deg) scale(0.7);
  }
  .hdr-now {
    min-width: 12ch;
    text-align: center;
  }
  .hdr-nav {
    justify-self: end;
    display: flex;
    gap: 28px;
  }
  .hdr-menu {
    display: none;
    justify-self: end;
    min-height: 44px;
    padding-inline: 4px;
  }
  @media (max-width: 860px) {
    .hdr-nav {
      display: none;
    }
    .hdr-menu {
      display: block;
    }
    .hdr {
      grid-template-columns: 1fr auto auto;
      gap: 16px;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: var(--ink);
    color: var(--paper);
    padding: calc(var(--header-h) + 24px) var(--pad) 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .menu[hidden] {
    display: none;
  }
  .menu ol {
    display: grid;
  }
  .menu a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    font-size: clamp(40px, 12vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 500;
    padding-block: 6px;
    border-bottom: 1px solid rgb(236 234 228 / 0.14);
  }
  .menu-foot {
    padding-top: 24px;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
  const menu = document.querySelector<HTMLElement>("[data-menu]")!;
  const label = document.querySelector<HTMLElement>("[data-menu-label]")!;

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    label.textContent = open ? "Close" : "Menu";
    document.documentElement.style.overflow = open ? "hidden" : "";
    window.dispatchEvent(new CustomEvent(open ? "lenis:stop" : "lenis:start"));
  };

  toggle.addEventListener("click", () => setOpen(menu.hasAttribute("hidden")));
  menu.querySelectorAll("[data-menu-link]").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
