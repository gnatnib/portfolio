---
import { Image } from "astro:assets";
import { projects } from "../data";

const featured = projects.filter((p) => p.featured);
const pad = (n: number) => String(n).padStart(2, "0");
const hostOf = (url: string) => new URL(url).host.replace(/^www\./, "");

// Buttons each dot scene offers under the stage.
const actions: Record<string, { act: string; label: string }[]> = {
  scanmbg: [
    { act: "scan", label: "Scan tray" },
    { act: "refill", label: "Refill" },
  ],
  rumeet: [{ act: "clear", label: "Clear my bookings" }],
  "helmet-detection": [{ act: "pause", label: "Pause" }],
};
---

<section id="work" class="sec work" data-tone="dark" data-label="Work" tabindex="-1">
  <header class="sec-head wrap">
    <p class="sec-index mono">(02) Work</p>
    <h2 class="sec-title" data-reveal="lines">Selected work<sup>({pad(featured.length)})</sup></h2>
  </header>

  <div class="spx wrap" data-spx>
    <div class="spx-stage" data-stage>
      <canvas data-stage-canvas aria-hidden="true"></canvas>
      <div class="spx-top mono">
        <span class="num" data-stage-index>01 / {pad(featured.length)}</span>
        <span data-stage-name>{featured[0]?.title}</span>
        <span class="spx-ticks">
          {
            featured.map((p, i) => (
              <button type="button" data-stage-tick={i} aria-label={`Show ${p.title}`} aria-current={i === 0 ? "true" : "false"} />
            ))
          }
        </span>
      </div>
      <div class="spx-foot">
        <p class="mono spx-status" data-stage-status aria-live="polite"></p>
        <div class="spx-acts">
          {
            featured.flatMap((p) =>
              (actions[p.slug] ?? []).map((a) => (
                <button type="button" class="mono" data-scene={p.slug} data-act={a.act} data-magnetic hidden>
                  {a.label}
                </button>
              )),
            )
          }
        </div>
      </div>
    </div>

    <div class="spx-chapters">
      {
        featured.map((p, i) => (
          <article class="ch" data-chapter={p.slug} data-title={p.title} aria-labelledby={`pj-${p.slug}`}>
            <p class="mono muted">
              <span class="num">{pad(i + 1)}</span> / {p.kind}
            </p>
            <h3 id={`pj-${p.slug}`} class="ch-title">
              {p.title}
            </h3>
            <p class="ch-summary">{p.summary}</p>
            {p.detail && <p class="ch-detail muted">{p.detail}</p>}
            <dl class="ch-facts">
              <div>
                <dt class="mono muted">For</dt>
                <dd>{p.client}</dd>
              </div>
              <div>
                <dt class="mono muted">Year</dt>
                <dd class="num">{p.year}</dd>
              </div>
              <div>
                <dt class="mono muted">Stack</dt>
                <dd>{p.stack.join(", ")}</dd>
              </div>
            </dl>
            <a class="ch-shot" href={p.live ?? p.repo} target="_blank" rel="noopener" aria-label={`Open ${p.title}`} data-reveal="clip">
              <Image
                src={p.image}
                alt={`${p.title} screenshot`}
                widths={[480, 720, 960]}
                sizes="(max-width: 860px) 92vw, 30vw"
                loading="lazy"
              />
            </a>
            <p class="pj-links">
              {p.live && (
                <a href={p.live} target="_blank" rel="noopener" class="ul ul-on">
                  {hostOf(p.live)} <span class="arrow">↗</span>
                </a>
              )}
              {p.repo && (
                <a href={p.repo} target="_blank" rel="noopener" class="ul">
                  Source <span class="arrow">↗</span>
                </a>
              )}
            </p>
          </article>
        ))
      }
    </div>
  </div>

  <div class="idx wrap" data-peek-root data-reveal="stagger">
    <div class="idx-head">
      <h3 class="idx-title">List of projects</h3>
      <p class="mono muted">All {projects.length}, newest first. Open a row for details.</p>
    </div>
    <div class="idx-cols mono muted" aria-hidden="true">
      <span>No.</span><span>Project</span><span>Type</span><span>For</span><span>Stack</span><span>Year</span>
    </div>
    {
      projects.map((p, i) => (
        <details class="row" data-peek={i}>
          <summary>
            <span class="mono muted num">{pad(i + 1)}</span>
            <span class="row-title">{p.title}</span>
            <span class="row-kind muted">{p.kind}</span>
            <span class="row-client muted">{p.client}</span>
            <span class="row-stack muted">{p.stack.slice(0, 3).join(", ")}</span>
            <span class="num row-year">{p.year}</span>
            <span class="row-plus" aria-hidden="true" />
          </summary>
          <div class="row-body">
            <div class="row-thumb">
              <Image src={p.image} alt="" widths={[480, 720]} sizes="(max-width: 860px) 92vw, 30vw" loading="lazy" />
            </div>
            <div class="row-text">
              <p>{p.detail ?? p.summary}</p>
              <p class="muted">{p.stack.join(", ")}</p>
              <p class="pj-links">
                {p.live && (
                  <a href={p.live} target="_blank" rel="noopener" class="ul ul-on">
                    {hostOf(p.live)} <span class="arrow">↗</span>
                  </a>
                )}
                {p.repo && (
                  <a href={p.repo} target="_blank" rel="noopener" class="ul">
                    Source <span class="arrow">↗</span>
                  </a>
                )}
              </p>
            </div>
          </div>
        </details>
      ))
    }
    <div class="peek" aria-hidden="true" data-peek-box>
      {
        projects.map((p) => (
          <Image src={p.image} alt="" widths={[480]} sizes="320px" loading="lazy" data-peek-img />
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding-bottom: clamp(96px, 12vw, 180px);
  }

  /* Dot stage on the left stays put while the project chapters scroll past it. */
  .spx {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding-top: clamp(32px, 4vw, 56px);
  }
  .spx-stage {
    grid-column: 1 / span 7;
    position: sticky;
    top: calc(var(--header-h) + 16px);
    height: calc(100svh - var(--header-h) - 32px);
    align-self: start;
    border: 1px solid var(--rule);
    background: var(--bg);
    overflow: hidden;
  }
  html:not(.js) .spx-stage {
    display: none;
  }
  .spx-stage canvas {
    position: absolute;
    inset: 48px 12px 76px;
    width: calc(100% - 24px);
    height: calc(100% - 124px);
  }
  .spx-top {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
    height: 48px;
    border-bottom: 1px solid var(--rule);
  }
  .spx-ticks {
    display: flex;
    margin-left: auto;
  }
  .spx-ticks button {
    width: 30px;
    height: 32px;
    display: grid;
    place-items: center;
  }
  .spx-ticks button::before {
    content: "";
    width: 20px;
    height: 2px;
    background: var(--rule-strong);
    transition:
      background-color 0.3s var(--ease),
      width 0.3s var(--ease);
  }
  .spx-ticks button[aria-current="true"]::before {
    background: var(--fg);
    width: 26px;
  }
  .spx-foot {
    position: absolute;
    inset: auto 0 0;
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border-top: 1px solid var(--rule);
  }
  .spx-status {
    font-size: 12.5px;
    line-height: 1.45;
    max-width: 52ch;
    text-transform: none;
    letter-spacing: 0;
  }
  .spx-acts {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .spx-acts button {
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 12px;
    text-transform: uppercase;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .spx-acts button:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .spx-acts button[hidden] {
    display: none;
  }

  .spx-chapters {
    grid-column: 9 / span 4;
  }
  .ch {
    min-height: 92svh;
    display: grid;
    align-content: center;
    gap: 14px;
    padding-block: 48px;
  }
  .ch-title {
    font-size: clamp(36px, 4vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .ch-summary {
    font-size: 19px;
    line-height: 1.35;
    max-width: 34ch;
  }
  .ch-detail {
    font-size: 15px;
    line-height: 1.55;
    max-width: 46ch;
  }
  .ch-facts {
    margin-top: 6px;
  }
  .ch-facts div {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    align-items: baseline;
    padding-block: 9px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
  }
  .ch-facts div:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .ch-facts dt {
    font-size: 11px;
  }
  .ch-shot {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--panel);
    margin-top: 6px;
  }
  .ch-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .ch-shot:hover img {
    transform: scale(1.04);
  }
  .pj-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 15px;
  }

  /* Phones: the stage pins under the header, chapters scroll beneath it. */
  @media (max-width: 860px) {
    .spx {
      display: block;
    }
    .spx-stage {
      top: var(--header-h);
      height: calc(min(66vw, 34svh) + 136px);
      z-index: 2;
      margin-inline: calc(var(--pad) * -1);
      border-inline: 0;
      /* When the header slides away, paint the strip it leaves so chapters
         scrolling under the stage do not peek out above it. */
      box-shadow: 0 calc(var(--header-h) * -1) 0 var(--bg);
    }
    .spx-stage canvas {
      inset: 44px 8px 92px;
      width: calc(100% - 16px);
      height: calc(100% - 136px);
    }
    .spx-top {
      height: 44px;
    }
    .spx-foot {
      min-height: 92px;
      flex-direction: column;
      align-items: stretch;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
    }
    .spx-status {
      font-size: 11px;
    }
    .spx-acts button {
      min-height: 36px;
      font-size: 11px;
    }
    .ch {
      min-height: 0;
      padding-block: 40px 56px;
    }
    .ch-title {
      font-size: 40px;
    }
    .ch-summary {
      font-size: 17px;
    }
  }

  /* Index */
  .idx {
    position: relative;
    padding-top: clamp(96px, 10vw, 160px);
  }
  .idx-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 20px;
  }
  .idx-title {
    font-size: clamp(32px, 3.4vw, 56px);
    letter-spacing: -0.035em;
    font-weight: 500;
  }
  .idx-cols,
  .row summary {
    display: grid;
    grid-template-columns: 56px minmax(0, 2.2fr) minmax(0, 1.2fr) minmax(0, 1.5fr) minmax(0, 2fr) 56px 24px;
    gap: var(--gap);
    align-items: baseline;
  }
  .idx-cols {
    padding-block: 10px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .row {
    border-bottom: 1px solid var(--rule);
  }
  .row summary {
    list-style: none;
    cursor: pointer;
    padding-block: 18px;
    transition:
      padding 0.4s var(--ease),
      color 0.3s var(--ease);
  }
  .row summary::-webkit-details-marker {
    display: none;
  }
  .row-title {
    font-size: clamp(18px, 1.6vw, 24px);
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .row-year {
    text-align: right;
  }
  .row-plus {
    position: relative;
    width: 12px;
    height: 12px;
    justify-self: end;
    align-self: center;
  }
  .row-plus::before,
  .row-plus::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 0.35s var(--ease);
  }
  .row-plus::after {
    transform: rotate(90deg);
  }
  .row[open] .row-plus::after {
    transform: rotate(0);
  }
  @media (hover: hover) {
    .idx:hover .row summary {
      color: var(--muted);
    }
    .idx .row summary:hover {
      color: var(--fg);
      padding-inline-start: 12px;
    }
  }
  .row-body {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--gap);
    padding-bottom: 28px;
  }
  .row-thumb {
    grid-column: 2;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--panel);
  }
  .row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row-text {
    display: grid;
    gap: 12px;
    align-content: start;
    max-width: 56ch;
  }

  .peek {
    position: fixed;
    left: 0;
    top: 0;
    width: 300px;
    aspect-ratio: 4 / 3;
    pointer-events: none;
    z-index: 30;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    clip-path: inset(50% 50% 50% 50%);
    transition:
      clip-path 0.45s var(--ease),
      opacity 0.2s linear,
      visibility 0s linear 0.45s;
  }
  .peek.on {
    opacity: 1;
    visibility: visible;
    clip-path: inset(0 0 0 0);
    transition:
      clip-path 0.45s var(--ease),
      opacity 0.2s linear;
  }
  .peek img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .peek img.on {
    opacity: 1;
  }
  @media (hover: none), (max-width: 860px) {
    .peek {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .idx-cols {
      display: none;
    }
    .row summary {
      grid-template-columns: 32px minmax(0, 1fr) auto 16px;
      row-gap: 4px;
    }
    .row-kind,
    .row-client,
    .row-stack {
      display: none;
    }
    .row-body {
      grid-template-columns: 1fr;
    }
    .row-thumb {
      grid-column: 1;
    }
  }
</style>

<script>
  import { ScrollTrigger, lenis, reduced } from "../scripts/motion";
  import { mountPeek } from "../scripts/peek";
  import { mountStage, pangan, scanmbg, rumeet, helmet, fallback, type SceneFactory } from "../scripts/specimen";

  document.querySelectorAll<HTMLElement>("#work [data-peek-root]").forEach(mountPeek);

  const root = document.querySelector<HTMLElement>("[data-stage]");
  if (root) {
    const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
    const known: Record<string, SceneFactory> = {
      "pangan-id": pangan,
      scanmbg,
      rumeet,
      "helmet-detection": helmet,
    };
    const factories: Record<string, SceneFactory> = {};
    chapters.forEach((ch) => {
      factories[ch.dataset.chapter!] = known[ch.dataset.chapter!] ?? fallback(ch.dataset.title!);
    });

    const stage = mountStage(root, factories, reduced);
    const index = root.querySelector<HTMLElement>("[data-stage-index]")!;
    const name = root.querySelector<HTMLElement>("[data-stage-name]")!;
    const ticks = [...root.querySelectorAll<HTMLButtonElement>("[data-stage-tick]")];
    const total = String(chapters.length).padStart(2, "0");

    const activate = (i: number) => {
      const ch = chapters[i];
      stage.show(ch.dataset.chapter!);
      index.textContent = `${String(i + 1).padStart(2, "0")} / ${total}`;
      name.textContent = ch.dataset.title!;
      ticks.forEach((t, j) => t.setAttribute("aria-current", String(i === j)));
    };
    activate(0);

    // A chapter owns the stage while it crosses the reading line. Enter
    // callbacks fire for every chapter a fast jump skips, in order, so the
    // stage ends on the right one.
    chapters.forEach((ch, i) =>
      ScrollTrigger.create({
        trigger: ch,
        start: "top 60%",
        end: "bottom 60%",
        onEnter: () => activate(i),
        onEnterBack: () => activate(i),
      }),
    );

    ticks.forEach((tick, i) =>
      tick.addEventListener("click", () => {
        const phone = matchMedia("(max-width: 860px)").matches;
        const offset = phone ? -root.getBoundingClientRect().bottom + 8 : -innerHeight * 0.2;
        if (lenis) lenis.scrollTo(chapters[i], { offset, duration: 1.2 });
        else scrollTo({ top: chapters[i].getBoundingClientRect().top + scrollY + offset });
        activate(i);
      }),
    );
  }
</script>
