---
import AsciiPortrait from "./AsciiPortrait.astro";

const lines = [
  { text: "Bintang", pos: "l1" },
  { text: "Syafrian", pos: "l2" },
  { text: "Rizal", pos: "l3" },
];
---

<section class="hero" data-tone="light" data-label="Index" aria-label="Introduction" data-hero>
  <p class="hero-meta hero-tl mono">
    <span>Software engineer, CIMB Niaga</span>
    <span class="muted">Web and machine learning</span>
  </p>
  <p class="hero-meta hero-tr mono">
    <span>Semarang, ID</span>
    <span class="muted"><span class="num" data-clock>--:--</span> WIB</span>
  </p>

  <div class="hero-stage">
    <div class="hero-portrait" data-hero-portrait>
      <AsciiPortrait />
    </div>

    <h1 class="hero-name" aria-label="Bintang Syafrian Rizal" data-name>
      {
        lines.map((l) => (
          <span class={`hero-line ${l.pos}`} aria-hidden="true" data-hero-line>
            {[...l.text].map((ch) => (
              <span class="ch" data-ch>
                {ch}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
  </div>

  <div class="hero-foot">
    <p class="hero-lead">Web apps and ML systems that people actually use.</p>
    <a href="#about" class="hero-scroll mono" aria-label="Scroll to About">
      Scroll <span class="hero-scroll-bar" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    padding: var(--header-h) var(--pad) 0;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
  }
  .hero-meta {
    position: absolute;
    top: calc(var(--header-h) + 12px);
    display: grid;
    gap: 2px;
    z-index: 3;
  }
  .hero-tl {
    left: var(--pad);
  }
  .hero-tr {
    right: var(--pad);
    text-align: right;
  }

  .hero-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding-block: 12px;
  }
  .hero-portrait {
    height: 100%;
    max-height: 100%;
    aspect-ratio: 3 / 4;
    min-height: 0;
    position: relative;
    z-index: 1;
  }
  .hero-portrait :global(.ap) {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .hero-portrait :global(.ap-frame) {
    flex: 1;
    aspect-ratio: auto;
    min-height: 0;
  }

  /* White text with difference blending reads as ink on paper and flips to
     light where it crosses the portrait. */
  .hero-name {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    color: #fff;
    mix-blend-mode: difference;
    font-size: clamp(64px, min(15vw, 19svh), 230px);
    line-height: 0.82;
    letter-spacing: -0.055em;
    font-weight: 500;
  }
  .hero-line {
    position: absolute;
    display: block;
    overflow: hidden;
    padding: 0.02em 0.04em 0.1em;
    white-space: nowrap;
  }
  .l1 {
    left: 0;
    top: 10%;
  }
  .l2 {
    right: 0;
    top: 38%;
  }
  .l3 {
    left: 6%;
    top: 66%;
  }
  .ch {
    display: inline-block;
    font-variation-settings: "wght" var(--w, 500);
  }
  html.motion .ch {
    transform: translateY(110%);
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 14px 18px;
    border-top: 1px solid var(--rule);
  }
  .hero-lead {
    font-size: clamp(15px, 1.2vw, 18px);
  }
  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
  }
  .hero-scroll-bar {
    width: 28px;
    height: 1px;
    background: var(--rule-strong);
    position: relative;
    overflow: hidden;
  }
  .hero-scroll-bar::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--fg);
    animation: slide 1.8s var(--ease) infinite;
  }
  @keyframes slide {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(100%);
    }
  }

  @media (max-width: 860px) {
    .hero {
      height: auto;
      min-height: 100svh;
    }
    .hero-stage {
      padding-top: 64px;
    }
    .hero-portrait {
      height: auto;
      width: min(80vw, 420px);
    }
    .hero-portrait :global(.ap-frame) {
      aspect-ratio: 3 / 4;
    }
    .hero-name {
      font-size: clamp(56px, 19vw, 120px);
    }
    .l1 {
      top: 8%;
    }
    .l2 {
      top: 36%;
    }
    .l3 {
      top: 62%;
      left: 2%;
    }
  }
</style>

<script>
  import { gsap, reduced } from "../scripts/motion";

  const clock = document.querySelector<HTMLElement>("[data-clock]")!;
  const fmt = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" });
  const tick = () => (clock.textContent = fmt.format(new Date()));
  tick();
  setInterval(tick, 15_000);

  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  const name = hero.querySelector<HTMLElement>("[data-name]")!;
  const chars = [...name.querySelectorAll<HTMLElement>("[data-ch]")];
  const lines = [...hero.querySelectorAll<HTMLElement>("[data-hero-line]")];

  if (!reduced) {
    gsap.fromTo(
      chars,
      { yPercent: 110, y: 0 },
      { yPercent: 0, duration: 1.2, ease: "expo.out", stagger: 0.04, delay: 0.15 },
    );

    // On the way out the three lines slide apart and the portrait sinks back.
    const out = gsap.timeline({
      scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.5 },
    });
    out
      .to(lines[0], { xPercent: -35, ease: "none" }, 0)
      .to(lines[1], { xPercent: 35, ease: "none" }, 0)
      .to(lines[2], { xPercent: -50, ease: "none" }, 0)
      .to("[data-hero-portrait]", { scale: 0.86, yPercent: 12, ease: "none" }, 0);
  }

  /* Letters thicken toward the cursor. Geist is a variable font, so this is a
     weight change, not a scale: the line keeps its rhythm. */
  if (!reduced && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let mx = -9999;
    let my = -9999;
    let frame = 0;
    const weights = chars.map(() => 500);

    const step = () => {
      frame = 0;
      let moving = false;
      // Read every rect before writing any style, so the loop costs one layout.
      const rects = chars.map((el) => el.getBoundingClientRect());
      chars.forEach((el, i) => {
        const r = rects[i];
        const d = Math.hypot(r.left + r.width / 2 - mx, r.top + r.height / 2 - my);
        // Thin far away, heavy under the cursor; back to 500 when it leaves.
        const target = mx < -9000 ? 500 : 300 + 600 * Math.max(0, 1 - d / 420);
        weights[i] += (target - weights[i]) * 0.18;
        if (Math.abs(target - weights[i]) > 0.5) moving = true;
        el.style.setProperty("--w", weights[i].toFixed(0));
      });
      if (moving) frame = requestAnimationFrame(step);
    };
    const kick = () => {
      if (!frame) frame = requestAnimationFrame(step);
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        mx = e.clientX;
        my = e.clientY;
        kick();
      },
      { passive: true },
    );
    document.addEventListener("pointerleave", () => {
      mx = my = -9999;
      kick();
    });
  }
</script>
