---
import { Image } from "astro:assets";
import { experience } from "../data";

const START = { y: 2022, m: 1 };
const END = { y: 2026, m: 12 };
const index = (ym: string) => {
  const [y, m] = ym.split("-").map(Number);
  return (y - START.y) * 12 + (m - START.m);
};
const total = index(`${END.y}-${END.m}`) + 1;
const years = Array.from({ length: END.y - START.y + 1 }, (_, i) => START.y + i);
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// Ongoing roles run to the month the site was built.
const built = new Date();
const thisMonth = `${built.getFullYear()}-${String(built.getMonth() + 1).padStart(2, "0")}`;
const rows = experience.map((x) => {
  const to = x.to ?? thisMonth;
  return {
    ...x,
    left: (index(x.from) / total) * 100,
    width: ((index(to) - index(x.from) + 1) / total) * 100,
    point: x.from === to,
    ongoing: x.to === null,
  };
});
---

<section id="experience" class="sec wrap" data-tone="light" data-label="Experience" tabindex="-1">
  <header class="sec-head">
    <p class="sec-index mono">(03) Experience</p>
    <h2 class="sec-title" data-reveal="lines">Timeline</h2>
  </header>

  <div class="tl" data-tl data-start={`${START.y}-${START.m}`} data-total={total}>
    <div class="tl-chart">
      <div class="tl-legend mono muted" aria-hidden="true">
        <span><i class="k-work"></i>Work</span>
        <span><i class="k-teaching"></i>Teaching</span>
        <span><i class="k-event"></i>Event</span>
        <span><i class="k-study"></i>Study</span>
      </div>

      <div class="tl-axis mono muted" aria-hidden="true">
        <span class="tl-axis-label"></span>
        <span class="tl-years">
          {years.map((y, i) => <span style={`left:${((i * 12) / total) * 100}%`}>{y}</span>)}
        </span>
      </div>

      <ol class="tl-rows" data-reveal="stagger">
        {
          rows.map((r, i) => (
            <li>
              <button
                type="button"
                class:list={["tl-row", { "is-on": i === 0 }]}
                data-tl-row={i}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <span class="tl-when mono" aria-hidden="true">
                  <span class="num">{r.from.slice(0, 4)}</span>
                  <span class="muted">{MONTHS[Number(r.from.slice(5, 7)) - 1]}</span>
                </span>
                <span class:list={["tl-dot", `k-${r.kind.toLowerCase()}`, { "is-ongoing": r.ongoing }]} aria-hidden="true" />
                <span class="tl-label">
                  <Image src={r.logo} alt="" width={28} height={28} densities={[1, 2]} class="tl-logo" />
                  <span class="tl-text">
                    <span class="tl-role">{r.role}</span>
                    <span class="tl-org muted">{r.org}</span>
                    <span class="tl-period mono muted">{r.period}</span>
                  </span>
                </span>
                <span class="tl-track">
                  {years.map((_, y) => (
                    <span class="tl-grid" style={`left:${((y * 12) / total) * 100}%`} />
                  ))}
                  <span
                    class:list={["tl-bar", `k-${r.kind.toLowerCase()}`, { "is-point": r.point, "is-ongoing": r.ongoing }]}
                    style={`left:${r.left}%;width:${r.width}%`}
                    data-tl-bar
                  />
                </span>
              </button>
            </li>
          ))
        }
      </ol>
      <span class="tl-now mono" data-tl-now aria-hidden="true"><span>Now</span></span>
    </div>

    <aside class="tl-detail" aria-live="polite">
      {
        rows.map((r, i) => (
          <article class:list={["tl-card", { "is-on": i === 0 }]} data-tl-card={i} hidden={i !== 0}>
            <div class="tl-photos" data-strip>
              {r.photos.length ? (
                <ul class="tl-strip" data-strip-track>
                  {r.photos.map((p, k) => (
                    <li>
                      <Image
                        src={p}
                        alt={`${r.role}, ${r.org}, photo ${k + 1} of ${r.photos.length}`}
                        widths={[480, 720, 960]}
                        sizes="(max-width: 860px) 90vw, 30vw"
                        loading="lazy"
                        draggable="false"
                      />
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="tl-photo-empty">
                  <Image src={r.logo} alt="" width={120} height={120} class="tl-photo-logo" />
                </div>
              )}
              {r.photos.length > 1 && (
                <div class="tl-strip-nav">
                  <button type="button" class="mono" data-strip-prev aria-label="Previous photo" data-magnetic>
                    Prev
                  </button>
                  <span class="mono num" data-strip-count>
                    1 / {r.photos.length}
                  </span>
                  <button type="button" class="mono" data-strip-next aria-label="Next photo" data-magnetic>
                    Next
                  </button>
                </div>
              )}
            </div>
            <p class="mono muted">
              {r.kind} · {r.period}
            </p>
            <h3 class="tl-card-role">{r.role}</h3>
            <p class="muted">{r.org}</p>
            <p>{r.text}</p>
          </article>
        ))
      }
    </aside>
  </div>
</section>

<style>
  .tl {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 32px;
    padding-top: clamp(32px, 4vw, 56px);
    --label-w: clamp(200px, 22vw, 320px);
  }
  .tl-chart {
    grid-column: 1 / span 8;
    position: relative;
  }
  .tl-legend {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .tl-legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .tl-legend i {
    width: 18px;
    height: 8px;
    border-radius: 4px;
  }
  .tl-axis,
  .tl-row {
    display: grid;
    grid-template-columns: var(--label-w) 1fr;
    gap: 16px;
    align-items: center;
  }
  .tl-axis {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .tl-years {
    position: relative;
    height: 1em;
  }
  .tl-years span {
    position: absolute;
    top: 0;
  }
  .tl-row {
    width: 100%;
    text-align: left;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
    transition: background-color 0.25s var(--ease);
  }
  .tl-row:hover,
  .tl-row.is-on {
    background: var(--panel);
  }
  .tl-label {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding-left: 8px;
  }
  .tl-label :global(.tl-logo) {
    width: 28px;
    height: 28px;
    object-fit: contain;
    background: #fff;
    border-radius: 6px;
    border: 1px solid var(--rule);
    flex: none;
  }
  .tl-text {
    display: grid;
    min-width: 0;
  }
  .tl-role {
    font-weight: 500;
    font-size: 15px;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tl-org {
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tl-track {
    position: relative;
    height: 28px;
  }
  .tl-grid {
    position: absolute;
    top: -10px;
    bottom: -10px;
    width: 1px;
    background: var(--rule);
  }
  .tl-bar {
    position: absolute;
    top: 6px;
    height: 16px;
    min-width: 10px;
    border-radius: 8px;
    transform-origin: 0 50%;
  }
  .tl-bar.is-point {
    width: 16px !important;
    margin-left: -4px;
  }
  .k-work {
    background: var(--accent);
  }
  .k-teaching {
    background: var(--fg);
  }
  .k-event {
    background: var(--muted);
  }
  .k-study {
    background: transparent;
    border: 1.5px solid var(--fg);
  }
  .tl-row.is-on .tl-bar {
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--fg);
  }
  .tl-now {
    position: absolute;
    bottom: 0;
    width: 1px;
    background: var(--accent);
    pointer-events: none;
    display: none;
  }
  .tl-now span {
    position: absolute;
    top: -2px;
    left: 6px;
    color: var(--accent);
  }

  .tl-detail {
    grid-column: 9 / span 4;
    position: sticky;
    top: calc(var(--header-h) + 16px);
    align-self: start;
  }
  .tl-card {
    display: grid;
    gap: 8px;
  }
  .tl-card[hidden] {
    display: none;
  }
  .tl-photos {
    position: relative;
    margin-bottom: 8px;
  }
  /* Scroll-snapping strip: swipe, drag or use the buttons. */
  .tl-strip {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
    overscroll-behavior-x: contain;
  }
  .tl-strip::-webkit-scrollbar {
    display: none;
  }
  .tl-strip.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .tl-strip li {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--panel);
  }
  .tl-strip :global(img) {
    width: 100%;
    height: 100%;
    /* Photos mix portrait and landscape; show each whole rather than crop people out. */
    object-fit: contain;
    user-select: none;
  }
  .tl-photo-empty {
    aspect-ratio: 4 / 3;
    background: var(--panel);
    display: grid;
    place-items: center;
  }
  .tl-photo-empty :global(.tl-photo-logo) {
    width: 96px;
    height: 96px;
    object-fit: contain;
  }
  .tl-strip-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
  }
  .tl-strip-nav button {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
  }
  .tl-strip-nav button:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .tl-bar.is-ongoing {
    border-radius: 8px 0 0 8px;
  }
  .tl-bar.is-ongoing::after {
    content: "";
    position: absolute;
    right: -6px;
    top: 0;
    width: 6px;
    height: 100%;
    background: repeating-linear-gradient(90deg, var(--accent) 0 2px, transparent 2px 4px);
  }
  .tl-card-role {
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 500;
  }

  .tl-when,
  .tl-dot,
  .tl-period {
    display: none;
  }

  /* Phones: a gantt squeezed into 360px says nothing. The rows become a
     vertical rail, newest first, and the detail opens under the tapped entry. */
  @media (max-width: 860px) {
    .tl-chart,
    .tl-detail {
      grid-column: 1 / -1;
    }
    .tl-detail {
      display: none;
    }
    .tl-axis,
    .tl-track,
    .tl-now {
      display: none !important;
    }
    .tl-legend {
      margin-bottom: 8px;
    }
    .tl-legend i {
      width: 11px;
      height: 11px;
      border-radius: 50%;
    }
    .tl-rows {
      position: relative;
    }
    .tl-rows::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 67.5px;
      width: 1px;
      background: var(--rule-strong);
    }
    .tl-row {
      grid-template-columns: 48px 16px minmax(0, 1fr);
      gap: 12px;
      align-items: start;
      padding-block: 18px;
      border-bottom: 0;
    }
    .tl-row:hover,
    .tl-row.is-on {
      background: none;
    }
    .tl-when {
      display: grid;
      font-size: 12px;
      line-height: 1.3;
      text-align: right;
      padding-top: 2px;
    }
    .tl-dot {
      display: block;
      position: relative;
      width: 13px;
      height: 13px;
      margin: 5px auto 0;
      border-radius: 50%;
      box-shadow: 0 0 0 4px var(--bg);
      transition: transform 0.3s var(--ease);
    }
    .tl-dot.is-ongoing {
      box-shadow:
        0 0 0 3px var(--bg),
        0 0 0 4.5px var(--accent);
    }
    .tl-row.is-on .tl-dot {
      transform: scale(1.3);
    }
    .tl-label {
      padding-left: 0;
      align-items: start;
    }
    .tl-role,
    .tl-org {
      white-space: normal;
    }
    .tl-role {
      font-size: 16px;
    }
    .tl-period {
      display: block;
      font-size: 11px;
      padding-top: 4px;
    }
    /* The detail card is moved into the row's list item by the script. */
    .tl-rows .tl-card {
      margin: 0 0 24px 88px;
    }
    .tl-rows .tl-card > .mono,
    .tl-rows .tl-card-role,
    .tl-rows .tl-card-role + .muted {
      display: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from "../scripts/motion";

  const tl = document.querySelector<HTMLElement>("[data-tl]")!;
  const rows = [...tl.querySelectorAll<HTMLButtonElement>("[data-tl-row]")];
  const cards = [...tl.querySelectorAll<HTMLElement>("[data-tl-card]")];

  const aside = tl.querySelector<HTMLElement>(".tl-detail")!;
  const phone = matchMedia("(max-width: 860px)");
  let current = 0;

  const select = (i: number) => {
    current = i;
    rows.forEach((r, j) => {
      r.classList.toggle("is-on", i === j);
      r.setAttribute("aria-pressed", String(i === j));
    });
    cards.forEach((c, j) => (c.hidden = i !== j));
  };

  // Phones show each card under its own row; wider screens keep them in the side panel.
  const home = () => {
    cards.forEach((c, j) => (phone.matches ? rows[j].parentElement!.append(c) : aside.append(c)));
    if (!phone.matches && current < 0) select(0);
  };
  home();
  phone.addEventListener("change", home);

  rows.forEach((row, i) => {
    // On a phone, tapping the open entry closes it again.
    row.addEventListener("click", () => {
      select(phone.matches && current === i ? -1 : i);
      // The page below just changed height; keep scroll-linked effects on their marks.
      if (phone.matches) requestAnimationFrame(() => ScrollTrigger.refresh());
    });
    // Hover selects only after the pointer rests, so moving across rows on the
    // way to the photo panel does not swap the panel out.
    let rest = 0;
    row.addEventListener("mouseenter", () => {
      if (!phone.matches) rest = window.setTimeout(() => select(i), 220);
    });
    row.addEventListener("mouseleave", () => clearTimeout(rest));
    row.addEventListener("focus", () => phone.matches || select(i));
  });

  // Today's marker, placed on the same scale as the bars.
  const [sy, sm] = tl.dataset.start!.split("-").map(Number);
  const total = Number(tl.dataset.total);
  const now = new Date();
  const months = (now.getFullYear() - sy) * 12 + (now.getMonth() + 1 - sm) + now.getDate() / 31;
  const marker = tl.querySelector<HTMLElement>("[data-tl-now]")!;
  const track = rows[0].querySelector<HTMLElement>(".tl-track")!;
  const place = () => {
    const chart = marker.parentElement!.getBoundingClientRect();
    const t = track.getBoundingClientRect();
    marker.style.left = `${t.left - chart.left + (t.width * months) / total}px`;
    marker.style.top = `${t.top - chart.top - 12}px`;
    marker.style.display = months >= 0 && months <= total ? "block" : "none";
  };
  place();
  new ResizeObserver(place).observe(tl);

  // Photo strips: buttons step one photo, a mouse can drag, touch swipes natively.
  tl.querySelectorAll<HTMLElement>("[data-strip]").forEach((strip) => {
    const track = strip.querySelector<HTMLElement>("[data-strip-track]");
    const count = strip.querySelector<HTMLElement>("[data-strip-count]");
    if (!track || !count) return;
    const n = track.children.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) =>
      track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior: reduced ? "auto" : "smooth" });
    strip.querySelector("[data-strip-prev]")!.addEventListener("click", () => go(current() - 1));
    strip.querySelector("[data-strip-next]")!.addEventListener("click", () => go(current() + 1));
    track.addEventListener("scroll", () => (count.textContent = `${current() + 1} / ${n}`), { passive: true });

    let startX = 0;
    let startLeft = 0;
    let dragging = false;
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse") return;
      dragging = true;
      startX = e.clientX;
      startLeft = track.scrollLeft;
      track.classList.add("is-dragging");
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener("pointermove", (e) => {
      if (dragging) track.scrollLeft = startLeft - (e.clientX - startX);
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove("is-dragging");
      go(current());
    };
    track.addEventListener("pointerup", end);
    track.addEventListener("pointercancel", end);
  });

  if (!reduced) {
    gsap.from(tl.querySelectorAll("[data-tl-bar]"), {
      scaleX: 0,
      duration: 1.2,
      ease: "expo.out",
      stagger: 0.08,
      scrollTrigger: { trigger: tl, start: "top 75%", once: true },
    });
  }
</script>
