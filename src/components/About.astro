---
import { Image } from "astro:assets";
import * as icons from "simple-icons";
import { stack, projects, certificateGroups } from "../data";
import run from "../assets/run.jpg";

type SimpleIcon = { path: string; hex: string };
const iconSet = icons as unknown as Record<string, SimpleIcon>;

const groups = (["Web", "Data", "Infra"] as const).map((group) => ({
  group,
  items: stack
    .filter((s) => s.group === group)
    .map((s) => {
      const icon = s.icon ? iconSet[`si${s.icon[0].toUpperCase()}${s.icon.slice(1)}`] : null;
      if (s.icon && !icon) throw new Error(`simple-icons has no "${s.icon}"`);
      // Which of the projects listed on this site use this tool.
      const used = projects
        .filter((p) => p.stack.some((x) => x.toLowerCase().startsWith(s.name.toLowerCase())))
        .map((p) => p.title);
      return { name: s.name, path: icon?.path ?? null, color: icon ? `#${icon.hex}` : null, used };
    })
    .sort((a, b) => b.used.length - a.used.length),
}));
const maxUsed = Math.max(...groups.flatMap((g) => g.items.map((i) => i.used.length)));

const certCount = certificateGroups.reduce((n, g) => n + g.items.length, 0);
const numbers = [
  { value: 3.65, decimals: 2, label: "GPA, Computer Science" },
  { value: projects.length, decimals: 0, label: "Projects built" },
  { value: 2, decimals: 0, label: "Internships" },
  { value: certCount, decimals: 0, label: "Certificates" },
];
---

<section id="about" class="sec wrap" data-tone="light" data-label="About" tabindex="-1">
  <header class="sec-head">
    <p class="sec-index mono">(01) About</p>
    <h2 class="sec-title" data-reveal="lines">Hi, I'm Bintang</h2>
  </header>

  <div class="ab">
    <figure class="ab-photo">
      <div class="ab-photo-frame" data-clip>
        <Image
          src={run}
          alt="Bintang running on a track"
          widths={[360, 540, 720]}
          sizes="(max-width: 860px) 70vw, 30vw"
          data-parallax-img
        />
      </div>
      <figcaption class="mono muted">Off the keyboard: tennis, 5K, mountains</figcaption>
    </figure>

    <div class="ab-body">
      <p class="ab-statement" data-reveal="lines">
        Software engineer at CIMB Niaga. I build web apps end to end, and train a model when the problem
        needs one.
      </p>

      <dl class="ab-nums">
        {
          numbers.map((n) => (
            <div>
              <dd class="num" data-count={n.value} data-decimals={n.decimals}>
                {n.value.toFixed(n.decimals)}
              </dd>
              <dt class="mono muted">{n.label}</dt>
            </div>
          ))
        }
      </dl>

      <p class="ab-note">
        <span class="mono muted">Studied</span>
        <span>B.Sc. Computer Science, Universitas Diponegoro, 2022 to 2026.</span>
      </p>
      <p class="ab-note">
        <span class="mono muted">Thesis</span>
        <span>LLM extractive summarization of Indonesian palm oil regulations.</span>
        <a href="https://lexpalm.streamlit.app" target="_blank" rel="noopener" class="ul ul-on"
          >LexPalm <span class="arrow">↗</span></a
        >
      </p>
      <p class="ab-note">
        <span class="mono muted">Tennis</span>
        <span>POPDA men's tennis: 1st sub-district 2015 and 2016, 3rd Semarang city 2016.</span>
      </p>
    </div>
  </div>

  <div class="stk">
    <div class="stk-head">
      <h3 class="stk-title">Stack<sup class="mono">({stack.length})</sup></h3>
      <p class="mono muted">Bars: how many of the projects on this site use it</p>
    </div>
    <div class="stk-cols">
      {
        groups.map((g) => (
          <div class="stk-col">
            <h4 class="stk-group mono">
              <span>{g.group}</span>
              <span class="muted num">{String(g.items.length).padStart(2, "0")}</span>
            </h4>
            <ul>
              {g.items.map((t) => (
                <li
                  class="stk-row"
                  style={t.color ? `--brand:${t.color}` : undefined}
                  title={t.used.length ? `Used in ${t.used.join(", ")}` : undefined}
                  data-stk-row
                >
                  <span class="stk-icon" aria-hidden="true">
                    {t.path ? (
                      <svg viewBox="0 0 24 24">
                        <path d={t.path} />
                      </svg>
                    ) : (
                      <span class="stk-mono mono">{t.name.slice(0, 3)}</span>
                    )}
                  </span>
                  <span class="stk-name">{t.name}</span>
                  <span class="stk-use" aria-label={`${t.used.length} projects`}>
                    <span class="stk-bar" style={`--w:${(t.used.length / maxUsed) * 100}%`} />
                    <span class="mono num muted">{t.used.length || ""}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ab {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    padding-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .ab-photo {
    grid-column: 1 / span 4;
  }
  .ab-photo-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--panel);
  }
  .ab-photo-frame img {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }
  .ab-photo figcaption {
    padding-top: 10px;
  }
  .ab-body {
    grid-column: 6 / span 7;
    display: grid;
    gap: 28px;
  }
  .ab-statement {
    font-size: clamp(26px, 2.8vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 450;
    max-width: 22ch;
    margin-bottom: clamp(12px, 2vw, 32px);
  }
  .ab-nums {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin-bottom: clamp(12px, 2vw, 32px);
  }
  .ab-nums div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 14px;
  }
  .ab-nums dd {
    font-size: clamp(40px, 4.6vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 400;
  }
  .ab-note {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: baseline;
    gap: 16px;
    font-size: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  .stk {
    padding-top: clamp(80px, 10vw, 140px);
  }
  .stk-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 20px;
  }
  .stk-title {
    font-size: clamp(32px, 3.4vw, 56px);
    letter-spacing: -0.035em;
    font-weight: 500;
    line-height: 1;
  }
  .stk-title sup {
    font-size: 12px;
    letter-spacing: 0;
    vertical-align: top;
    margin-left: 6px;
    font-weight: 400;
  }
  .stk-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .stk-group {
    display: flex;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-strong);
    font-weight: 400;
  }
  .stk-row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 96px;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    border-bottom: 1px solid var(--rule);
    transition: padding 0.35s var(--ease);
  }
  .stk-row:hover {
    padding-inline-start: 8px;
  }
  .stk-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background: #f8f7f3;
    border: 1px solid var(--rule);
    transition: background-color 0.3s var(--ease);
  }
  .stk-icon svg {
    width: 20px;
    height: 20px;
    fill: var(--ink);
    transition: fill 0.3s var(--ease);
  }
  /* Monochrome at rest so the list reads as one column; brand colour on hover. */
  .stk-row:hover .stk-icon svg {
    fill: var(--brand, var(--ink));
  }
  .stk-mono {
    font-size: 9px;
    letter-spacing: 0;
  }
  .stk-name {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .stk-use {
    display: grid;
    grid-template-columns: 1fr 18px;
    align-items: center;
    gap: 8px;
  }
  .stk-bar {
    height: 4px;
    border-radius: 2px;
    background: var(--rule);
    position: relative;
    overflow: hidden;
  }
  .stk-bar::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    background: var(--fg);
    border-radius: 2px;
    transform-origin: 0 50%;
    transform: scaleX(var(--grow, 1));
    transition: transform 1.1s var(--ease);
  }
  .stk-row:hover .stk-bar::after {
    background: var(--accent);
  }
  html.motion .stk:not(.is-in) .stk-bar::after {
    --grow: 0;
  }

  @media (max-width: 1100px) {
    .stk-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 860px) {
    .ab-photo {
      grid-column: 1 / span 8;
    }
    .ab-body {
      grid-column: 1 / -1;
    }
    .ab-nums {
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
    }
    .ab-note {
      grid-template-columns: 64px 1fr;
    }
    .ab-note a {
      grid-column: 2;
    }
  }
  @media (max-width: 640px) {
    .stk-cols {
      grid-template-columns: 1fr;
      row-gap: 32px;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from "../scripts/motion";

  if (!reduced) {
    // Numbers count up once they scroll in.
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
      const value = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals);
      const o = { v: 0 };
      el.textContent = (0).toFixed(decimals);
      gsap.to(o, {
        v: value,
        duration: 1.8,
        ease: "expo.out",
        onUpdate: () => (el.textContent = o.v.toFixed(decimals)),
        scrollTrigger: { trigger: el, start: "top 85%", once: true },
      });
    });

    // Photo opens from the bottom and drifts inside its frame.
    const frame = document.querySelector<HTMLElement>("[data-clip]")!;
    gsap.fromTo(
      frame,
      { clipPath: "inset(100% 0 0 0)" },
      {
        clipPath: "inset(0% 0 0 0)",
        duration: 1.4,
        ease: "expo.inOut",
        scrollTrigger: { trigger: frame, start: "top 85%", once: true },
      },
    );
    gsap.fromTo(
      "[data-parallax-img]",
      { yPercent: -12 },
      { yPercent: 0, ease: "none", scrollTrigger: { trigger: frame, start: "top bottom", end: "bottom top", scrub: true } },
    );

    // Stack rows rise in column by column, then the usage bars fill.
    const stk = document.querySelector<HTMLElement>(".stk")!;
    gsap.from(stk.querySelectorAll("[data-stk-row]"), {
      y: 16,
      opacity: 0,
      duration: 0.7,
      ease: "expo.out",
      stagger: 0.025,
      scrollTrigger: {
        trigger: stk,
        start: "top 75%",
        once: true,
        onEnter: () => setTimeout(() => stk.classList.add("is-in"), 300),
      },
    });
    ScrollTrigger.refresh();
  }
</script>
