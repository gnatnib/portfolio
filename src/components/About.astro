---
import { Image } from "astro:assets";
import * as icons from "simple-icons";
import { stack, projects, certificateGroups } from "../data";
import run from "../assets/run.jpg";

type SimpleIcon = { path: string; hex: string };
const iconSet = icons as unknown as Record<string, SimpleIcon>;

const tiles = stack.map((s) => {
  const icon = s.icon ? iconSet[`si${s.icon[0].toUpperCase()}${s.icon.slice(1)}`] : null;
  if (s.icon && !icon) throw new Error(`simple-icons has no "${s.icon}"`);
  return { ...s, path: icon?.path ?? null, color: icon ? `#${icon.hex}` : "var(--fg)" };
});
const groups = ["Web", "Data", "Infra"] as const;

const certCount = certificateGroups.reduce((n, g) => n + g.items.length, 0);
const numbers = [
  { value: 3.65, decimals: 2, label: "GPA, Computer Science" },
  { value: projects.length, decimals: 0, label: "Projects built" },
  { value: 2, decimals: 0, label: "Internships" },
  { value: certCount, decimals: 0, label: "Certificates" },
];
---

<section id="about" class="sec wrap" data-tone="light" data-label="About" tabindex="-1">
  <header class="sec-head">
    <p class="sec-index mono">(01) About</p>
    <h2 class="sec-title" data-reveal="lines">Hi, I'm Bintang</h2>
  </header>

  <div class="ab">
    <figure class="ab-photo">
      <div class="ab-photo-frame" data-clip>
        <Image
          src={run}
          alt="Bintang running on a track"
          widths={[360, 540, 720]}
          sizes="(max-width: 860px) 70vw, 30vw"
          data-parallax-img
        />
      </div>
      <figcaption class="mono muted">Off the keyboard: tennis, 5K, mountains</figcaption>
    </figure>

    <div class="ab-body">
      <p class="ab-statement" data-reveal="lines">
        Computer Science graduate from Universitas Diponegoro. I build web apps end to end, and train a
        model when the problem needs one.
      </p>

      <dl class="ab-nums">
        {
          numbers.map((n) => (
            <div>
              <dd class="num" data-count={n.value} data-decimals={n.decimals}>
                {n.value.toFixed(n.decimals)}
              </dd>
              <dt class="mono muted">{n.label}</dt>
            </div>
          ))
        }
      </dl>

      <p class="ab-thesis">
        <span class="mono muted">Thesis</span>
        <span>LLM extractive summarization of Indonesian palm oil regulations.</span>
        <a href="https://lexpalm.streamlit.app" target="_blank" rel="noopener" class="ul ul-on"
          >LexPalm <span class="arrow">↗</span></a
        >
      </p>
      <p class="ab-thesis">
        <span class="mono muted">Tennis</span>
        <span>POPDA men's tennis: 1st sub-district 2015 and 2016, 3rd Semarang city 2016.</span>
      </p>
    </div>
  </div>

  <div class="pit-wrap">
    <div class="pit-head">
      <h3 class="pit-title">Stack<sup class="mono">({tiles.length})</sup></h3>
      <div class="pit-filter" role="group" aria-label="Highlight a group">
        <button type="button" class="mono pit-chip is-on" data-group="all" aria-pressed="true">All</button>
        {
          groups.map((g) => (
            <button type="button" class="mono pit-chip" data-group={g} aria-pressed="false">
              {g}
            </button>
          ))
        }
      </div>
    </div>
    <div class="pit" data-pit data-group-active="all">
      <p class="pit-hint mono muted" aria-hidden="true">Grab one. Throw it.</p>
      <ul class="pit-tiles" data-pit-tiles>
        {
          tiles.map((t) => (
            <li class="tile" data-tile data-group={t.group} style={`--brand:${t.color}`}>
              {t.path ? (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={t.path} />
                </svg>
              ) : (
                <span class="tile-mono mono" aria-hidden="true">
                  {t.name.slice(0, 3)}
                </span>
              )}
              <span>{t.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .ab {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    padding-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .ab-photo {
    grid-column: 1 / span 4;
  }
  .ab-photo-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--panel);
  }
  .ab-photo-frame img {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }
  .ab-photo figcaption {
    padding-top: 10px;
  }
  .ab-body {
    grid-column: 6 / span 7;
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  .ab-statement {
    font-size: clamp(26px, 2.8vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 450;
    max-width: 22ch;
  }
  .ab-nums {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .ab-nums div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 14px;
  }
  .ab-nums dd {
    font-size: clamp(40px, 4.6vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 400;
  }
  .ab-thesis {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    font-size: 16px;
  }

  .pit-wrap {
    padding-top: clamp(80px, 10vw, 140px);
  }
  .pit-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 16px;
  }
  .pit-title {
    font-size: clamp(32px, 3.4vw, 56px);
    letter-spacing: -0.035em;
    font-weight: 500;
    line-height: 1;
  }
  .pit-title sup {
    font-size: 12px;
    letter-spacing: 0;
    vertical-align: top;
    margin-left: 6px;
    font-weight: 400;
  }
  .pit-filter {
    display: flex;
    gap: 8px;
  }
  .pit-chip {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .pit-chip.is-on {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .pit {
    position: relative;
    border: 1px solid var(--rule-strong);
    border-radius: 28px;
    overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, var(--rule) 1px, transparent 0) 0 0 / 22px 22px;
  }
  .pit-hint {
    position: absolute;
    left: 20px;
    top: 16px;
    pointer-events: none;
  }
  /* Without physics the tiles are a plain wrapped row. */
  .pit-tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 56px 20px 20px;
  }
  .tile {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 20px 0 14px;
    border-radius: 999px;
    background: #f8f7f3;
    border: 1px solid var(--rule-strong);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    user-select: none;
    transition:
      opacity 0.3s var(--ease),
      filter 0.3s var(--ease);
    color: var(--ink);
  }
  .tile svg {
    width: 26px;
    height: 26px;
    fill: var(--brand);
    flex: none;
  }
  .tile-mono {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    background: var(--ink);
    color: var(--paper);
    font-size: 9px;
  }
  .pit[data-group-active="Web"] .tile:not([data-group="Web"]),
  .pit[data-group-active="Data"] .tile:not([data-group="Data"]),
  .pit[data-group-active="Infra"] .tile:not([data-group="Infra"]) {
    opacity: 0.22;
    filter: grayscale(1);
  }

  .pit.is-physics {
    height: clamp(380px, 50svh, 500px);
    touch-action: pan-y;
  }
  .pit.is-physics .pit-tiles {
    display: block;
    padding: 0;
    position: absolute;
    inset: 0;
  }
  .pit.is-physics .tile {
    position: absolute;
    left: 0;
    top: 0;
    cursor: grab;
    will-change: transform;
  }
  .pit.is-physics.is-grabbing .tile {
    cursor: grabbing;
  }

  @media (max-width: 860px) {
    .ab-photo {
      grid-column: 1 / span 8;
    }
    .ab-body {
      grid-column: 1 / -1;
    }
    .ab-nums {
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
    }
    .tile {
      height: 46px;
      font-size: 14px;
      padding: 0 16px 0 10px;
    }
    .tile svg {
      width: 22px;
      height: 22px;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from "../scripts/motion";

  const pit = document.querySelector<HTMLElement>("[data-pit]")!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".pit-chip")];
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      pit.dataset.groupActive = chip.dataset.group;
      chips.forEach((c) => {
        c.classList.toggle("is-on", c === chip);
        c.setAttribute("aria-pressed", String(c === chip));
      });
    }),
  );

  if (!reduced) {
    // Numbers count up once they scroll in.
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
      const value = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals);
      const o = { v: 0 };
      el.textContent = (0).toFixed(decimals);
      gsap.to(o, {
        v: value,
        duration: 1.8,
        ease: "expo.out",
        onUpdate: () => (el.textContent = o.v.toFixed(decimals)),
        scrollTrigger: { trigger: el, start: "top 85%", once: true },
      });
    });

    // Photo opens from the bottom and drifts inside its frame.
    const frame = document.querySelector<HTMLElement>("[data-clip]")!;
    gsap.fromTo(
      frame,
      { clipPath: "inset(100% 0 0 0)" },
      {
        clipPath: "inset(0% 0 0 0)",
        duration: 1.4,
        ease: "expo.inOut",
        scrollTrigger: { trigger: frame, start: "top 85%", once: true },
      },
    );
    gsap.fromTo(
      "[data-parallax-img]",
      { yPercent: -12 },
      { yPercent: 0, ease: "none", scrollTrigger: { trigger: frame, start: "top bottom", end: "bottom top", scrub: true } },
    );

    // Physics loads only when the pit is close, so it costs nothing above the fold.
    ScrollTrigger.create({
      trigger: pit,
      start: "top 120%",
      once: true,
      onEnter: () => import("../scripts/stackpit").then((m) => m.mountStackPit(pit)),
    });
  }
</script>
