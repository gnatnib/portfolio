---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { stackGroups, projects, certificateGroups, type Tool } from "../data";
import run from "../assets/run.jpg";
import Spotify from "./Spotify.astro";

const logos = import.meta.glob<{ default: ImageMetadata }>("../assets/stack/*.svg", { eager: true });

// Where each tool shows up: project stacks, deploy hosts, and work outside the project list.
const usedIn = (t: Tool) => [
  ...new Set([
    ...projects
      .filter((p) => p.stack.some((s) => s === t.name || t.aka?.includes(s)) || (t.host && p.live?.includes(t.host)))
      .map((p) => p.title),
    ...(t.also ?? []),
  ]),
];

const groups = stackGroups.map((g) => ({
  name: g.name,
  tools: g.tools.map((t) => {
    const logo = logos[`../assets/stack/${t.logo}.svg`];
    if (!logo) throw new Error(`No logo file for ${t.name}: src/assets/stack/${t.logo}.svg`);
    return { name: t.name, src: logo.default.src, used: usedIn(t) };
  }),
}));

const certCount = certificateGroups.reduce((n, g) => n + g.items.length, 0);
const numbers = [
  { value: 3.65, decimals: 2, label: "GPA, Computer Science" },
  { value: projects.length, decimals: 0, label: "Projects built" },
  { value: 2, decimals: 0, label: "Internships" },
  { value: certCount, decimals: 0, label: "Certificates" },
];
---

<section id="about" class="sec wrap" data-tone="light" data-label="About" tabindex="-1">
  <header class="sec-head">
    <p class="sec-index mono">(01) About</p>
    <h2 class="sec-title" data-reveal="lines">Hi, I'm Bintang</h2>
  </header>

  <div class="ab">
    <figure class="ab-photo">
      <div class="ab-photo-frame" data-clip>
        <Image
          src={run}
          alt="Bintang running on a track"
          widths={[360, 540, 720]}
          sizes="(max-width: 860px) 70vw, 30vw"
          data-parallax-img
        />
      </div>
      <figcaption class="mono muted">Off the keyboard: tennis, 5K, mountains</figcaption>
    </figure>

    <div class="ab-body">
      <p class="ab-statement" data-reveal="lines">
        Software engineer at CIMB Niaga. I build web apps end to end, and train a model when the problem
        needs one.
      </p>

      <dl class="ab-nums" data-reveal="stagger">
        {
          numbers.map((n) => (
            <div>
              <dd class="num" data-count={n.value} data-decimals={n.decimals}>
                {n.value.toFixed(n.decimals)}
              </dd>
              <dt class="mono muted">{n.label}</dt>
            </div>
          ))
        }
      </dl>

      <p class="ab-note">
        <span class="mono muted">Studied</span>
        <span>B.Sc. Computer Science, Universitas Diponegoro, 2022 to 2026.</span>
      </p>
      <p class="ab-note">
        <span class="mono muted">Thesis</span>
        <span>LLM extractive summarization of Indonesian palm oil regulations.</span>
        <a href="https://lexpalm.streamlit.app" target="_blank" rel="noopener" class="ul ul-on"
          >LexPalm <span class="arrow">↗</span></a
        >
      </p>
      <p class="ab-note">
        <span class="mono muted">Tennis</span>
        <span>POPDA men's tennis: 1st sub-district 2015 and 2016, 3rd Semarang city 2016.</span>
      </p>
      <Spotify />
    </div>
  </div>

  <div class="stk">
    <div class="stk-head">
      <h3 class="stk-title">Stack</h3>
      <p class="mono muted">Grouped by job. Under each tool, where I shipped it.</p>
    </div>
    {
      groups.map((grp, gi) => (
        <div class="stk-group">
          <h4 class="stk-name">
            <span class="mono muted num">{String(gi + 1).padStart(2, "0")}</span>
            {grp.name}
          </h4>
          <ul class="stk-tools" data-reveal="stagger">
            {grp.tools.map((t) => (
              <li class="tool">
                <span class="tool-logo">
                  <img src={t.src} alt="" width="28" height="28" loading="lazy" decoding="async" />
                </span>
                <span class="tool-text">
                  <span class="tool-name">{t.name}</span>
                  {t.used.length > 0 && (
                    <span class="tool-used mono muted" title={t.used.join(", ")}>
                      {t.used.join(", ")}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .ab {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    padding-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .ab-photo {
    grid-column: 1 / span 4;
  }
  .ab-photo-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--panel);
  }
  .ab-photo-frame img {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }
  .ab-photo figcaption {
    padding-top: 10px;
  }
  .ab-body {
    grid-column: 6 / span 7;
    display: grid;
    gap: 28px;
  }
  .ab-statement {
    font-size: clamp(26px, 2.8vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 450;
    max-width: 22ch;
    margin-bottom: clamp(12px, 2vw, 32px);
  }
  .ab-nums {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin-bottom: clamp(12px, 2vw, 32px);
  }
  .ab-nums div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 14px;
  }
  .ab-nums dd {
    font-size: clamp(40px, 4.6vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 400;
  }
  .ab-note {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: baseline;
    gap: 16px;
    font-size: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  .stk {
    padding-top: clamp(80px, 10vw, 140px);
  }
  .stk-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 20px;
  }
  .stk-title {
    font-size: clamp(32px, 3.4vw, 56px);
    letter-spacing: -0.035em;
    font-weight: 500;
    line-height: 1;
  }

  /* One row per job: the group name on the left, its tools in a fixed
     four-column grid on the right, so every logo sits on the same column line. */
  .stk-group {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    border-top: 1px solid var(--rule-strong);
    padding-block: 20px;
  }
  .stk-group:last-child {
    border-bottom: 1px solid var(--rule-strong);
  }
  .stk-name {
    grid-column: 1 / span 3;
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: clamp(20px, 1.8vw, 26px);
    font-weight: 500;
    letter-spacing: -0.02em;
    padding-top: 10px;
  }
  .stk-name .mono {
    font-size: 12px;
    letter-spacing: 0;
  }
  .stk-tools {
    grid-column: 4 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--gap);
  }
  .tool {
    display: flex;
    gap: 14px;
    align-items: center;
    min-width: 0;
    padding-block: 10px;
  }
  .tool-logo {
    flex: none;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 10px;
    transition: transform 0.4s var(--ease);
  }
  .tool-logo img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .tool:hover .tool-logo {
    transform: translateY(-3px) rotate(-4deg);
  }
  .tool-text {
    display: grid;
    min-width: 0;
    gap: 2px;
  }
  .tool-name {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .tool-used {
    font-size: 11.5px;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1100px) {
    .stk-name {
      grid-column: 1 / -1;
      padding: 0 0 8px;
    }
    .stk-tools {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 860px) {
    .ab-photo {
      grid-column: 1 / span 8;
    }
    .ab-body {
      grid-column: 1 / -1;
    }
    .ab-nums {
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
    }
    .ab-note {
      grid-template-columns: 64px 1fr;
    }
    .ab-note a {
      grid-column: 2;
    }
  }
  @media (max-width: 640px) {
    .stk-tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tool {
      gap: 10px;
    }
    .tool-logo {
      width: 40px;
      height: 40px;
    }
    .tool-logo img {
      width: 24px;
      height: 24px;
    }
    .tool-name {
      font-size: 15px;
    }
  }
</style>

<script>
  import { gsap, reduced } from "../scripts/motion";

  if (!reduced) {
    // Numbers count up once they scroll in.
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
      const value = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals);
      const o = { v: 0 };
      el.textContent = (0).toFixed(decimals);
      gsap.to(o, {
        v: value,
        duration: 1.8,
        ease: "expo.out",
        onUpdate: () => (el.textContent = o.v.toFixed(decimals)),
        scrollTrigger: { trigger: el, start: "top 85%", once: true },
      });
    });

    // Photo opens from the bottom and drifts inside its frame.
    const frame = document.querySelector<HTMLElement>("[data-clip]")!;
    gsap.fromTo(
      frame,
      { clipPath: "inset(100% 0 0 0)" },
      {
        clipPath: "inset(0% 0 0 0)",
        duration: 1.4,
        ease: "expo.inOut",
        scrollTrigger: { trigger: frame, start: "top 85%", once: true },
      },
    );
    gsap.fromTo(
      "[data-parallax-img]",
      { yPercent: -12 },
      { yPercent: 0, ease: "none", scrollTrigger: { trigger: frame, start: "top bottom", end: "bottom top", scrub: true } },
    );
  }
</script>
