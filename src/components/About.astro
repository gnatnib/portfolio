---
import { Image } from "astro:assets";
import * as icons from "simple-icons";
import { stack, projects, certificateGroups } from "../data";
import run from "../assets/run.jpg";
import Spotify from "./Spotify.astro";

type SimpleIcon = { path: string; hex: string };
const iconSet = icons as unknown as Record<string, SimpleIcon>;

// Brand colour for the hover fill, and whichever of ink or paper reads on it.
const tiles = stack.map((s) => {
  const icon = s.icon ? iconSet[`si${s.icon[0].toUpperCase()}${s.icon.slice(1)}`] : null;
  if (s.icon && !icon) throw new Error(`simple-icons has no "${s.icon}"`);
  const hex = icon?.hex ?? "232F3E";
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return {
    name: s.name,
    group: s.group,
    path: icon?.path ?? null,
    color: `#${hex}`,
    onBrand: luminance > 0.55 ? "var(--ink)" : "#fff",
  };
});

const certCount = certificateGroups.reduce((n, g) => n + g.items.length, 0);
const numbers = [
  { value: 3.65, decimals: 2, label: "GPA, Computer Science" },
  { value: projects.length, decimals: 0, label: "Projects built" },
  { value: 2, decimals: 0, label: "Internships" },
  { value: certCount, decimals: 0, label: "Certificates" },
];
---

<section id="about" class="sec wrap" data-tone="light" data-label="About" tabindex="-1">
  <header class="sec-head">
    <p class="sec-index mono">(01) About</p>
    <h2 class="sec-title" data-reveal="lines">Hi, I'm Bintang</h2>
  </header>

  <div class="ab">
    <figure class="ab-photo">
      <div class="ab-photo-frame" data-clip>
        <Image
          src={run}
          alt="Bintang running on a track"
          widths={[360, 540, 720]}
          sizes="(max-width: 860px) 70vw, 30vw"
          data-parallax-img
        />
      </div>
      <figcaption class="mono muted">Off the keyboard: tennis, 5K, mountains</figcaption>
    </figure>

    <div class="ab-body">
      <p class="ab-statement" data-reveal="lines">
        Software engineer at CIMB Niaga. I build web apps end to end, and train a model when the problem
        needs one.
      </p>

      <dl class="ab-nums">
        {
          numbers.map((n) => (
            <div>
              <dd class="num" data-count={n.value} data-decimals={n.decimals}>
                {n.value.toFixed(n.decimals)}
              </dd>
              <dt class="mono muted">{n.label}</dt>
            </div>
          ))
        }
      </dl>

      <p class="ab-note">
        <span class="mono muted">Studied</span>
        <span>B.Sc. Computer Science, Universitas Diponegoro, 2022 to 2026.</span>
      </p>
      <p class="ab-note">
        <span class="mono muted">Thesis</span>
        <span>LLM extractive summarization of Indonesian palm oil regulations.</span>
        <a href="https://lexpalm.streamlit.app" target="_blank" rel="noopener" class="ul ul-on"
          >LexPalm <span class="arrow">↗</span></a
        >
      </p>
      <p class="ab-note">
        <span class="mono muted">Tennis</span>
        <span>POPDA men's tennis: 1st sub-district 2015 and 2016, 3rd Semarang city 2016.</span>
      </p>
      <Spotify />
    </div>
  </div>

  <div class="stk">
    <div class="stk-head">
      <h3 class="stk-title">Stack<sup class="mono">({tiles.length})</sup></h3>
      <div class="stk-tabs" role="group" aria-label="Show a group">
        {
          ["All", "Web", "Data", "Infra"].map((g, i) => (
            <button type="button" class="mono" data-stk-tab={g} aria-pressed={i === 0 ? "true" : "false"}>
              {g}
            </button>
          ))
        }
      </div>
    </div>
    <ul class="stk-wall" data-wall data-active="All">
      {
        tiles.map((t) => (
          <li class="tile" data-tile data-group={t.group} style={`--brand:${t.color};--on-brand:${t.onBrand}`}>
            <span class="tile-group mono muted">{t.group}</span>
            {t.path ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={t.path} />
              </svg>
            ) : (
              <span class="tile-mono" aria-hidden="true">
                {t.name}
              </span>
            )}
            <span class="tile-name">{t.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ab {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    padding-top: clamp(40px, 5vw, 72px);
    align-items: start;
  }
  .ab-photo {
    grid-column: 1 / span 4;
  }
  .ab-photo-frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--panel);
  }
  .ab-photo-frame img {
    width: 100%;
    height: 118%;
    object-fit: cover;
  }
  .ab-photo figcaption {
    padding-top: 10px;
  }
  .ab-body {
    grid-column: 6 / span 7;
    display: grid;
    gap: 28px;
  }
  .ab-statement {
    font-size: clamp(26px, 2.8vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 450;
    max-width: 22ch;
    margin-bottom: clamp(12px, 2vw, 32px);
  }
  .ab-nums {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    margin-bottom: clamp(12px, 2vw, 32px);
  }
  .ab-nums div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    border-top: 1px solid var(--rule-strong);
    padding-top: 14px;
  }
  .ab-nums dd {
    font-size: clamp(40px, 4.6vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 400;
  }
  .ab-note {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: baseline;
    gap: 16px;
    font-size: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  .stk {
    padding-top: clamp(80px, 10vw, 140px);
  }
  .stk-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    padding-bottom: 20px;
  }
  .stk-title {
    font-size: clamp(32px, 3.4vw, 56px);
    letter-spacing: -0.035em;
    font-weight: 500;
    line-height: 1;
  }
  .stk-title sup {
    font-size: 12px;
    letter-spacing: 0;
    vertical-align: top;
    margin-left: 6px;
    font-weight: 400;
  }
  .stk-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .stk-tabs button {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .stk-tabs button[aria-pressed="true"] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  /* Hairline grid: every tile draws its right and bottom rule, the wall draws
     the top and left, so lines never double up. */
  .stk-wall {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule-strong);
  }
  .tile {
    position: relative;
    aspect-ratio: 6 / 5;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    padding: 12px;
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    overflow: hidden;
    isolation: isolate;
    transition: opacity 0.35s var(--ease);
  }
  /* Brand colour rises from the bottom on hover. */
  .tile::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--brand, var(--fg));
    transform: translateY(101%);
    transition: transform 0.5s var(--ease);
  }
  .tile:hover::before {
    transform: translateY(0);
  }
  .tile-group {
    justify-self: start;
    font-size: 10px;
    transition: color 0.3s var(--ease);
  }
  .tile svg,
  .tile-mono {
    align-self: center;
    width: 38px;
    height: 38px;
    fill: var(--fg);
    transition:
      fill 0.3s var(--ease),
      transform 0.5s var(--ease);
  }
  .tile-mono {
    display: grid;
    place-items: center;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tile-name {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-align: center;
    transition: color 0.3s var(--ease);
  }
  .tile:hover svg,
  .tile:hover .tile-mono {
    transform: scale(1.12);
    fill: var(--on-brand);
    color: var(--on-brand);
  }
  .tile:hover .tile-name,
  .tile:hover .tile-group {
    color: var(--on-brand);
  }
  .stk-wall[data-active="Web"] .tile:not([data-group="Web"]),
  .stk-wall[data-active="Data"] .tile:not([data-group="Data"]),
  .stk-wall[data-active="Infra"] .tile:not([data-group="Infra"]) {
    opacity: 0.18;
  }

  @media (max-width: 1100px) {
    .stk-wall {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .ab-photo {
      grid-column: 1 / span 8;
    }
    .ab-body {
      grid-column: 1 / -1;
    }
    .ab-nums {
      grid-template-columns: 1fr 1fr;
      row-gap: 28px;
    }
    .ab-note {
      grid-template-columns: 64px 1fr;
    }
    .ab-note a {
      grid-column: 2;
    }
  }
  @media (max-width: 640px) {
    .stk-wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tile svg {
      width: 30px;
      height: 30px;
    }
  }
</style>

<script>
  import { gsap, reduced } from "../scripts/motion";

  if (!reduced) {
    // Numbers count up once they scroll in.
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
      const value = Number(el.dataset.count);
      const decimals = Number(el.dataset.decimals);
      const o = { v: 0 };
      el.textContent = (0).toFixed(decimals);
      gsap.to(o, {
        v: value,
        duration: 1.8,
        ease: "expo.out",
        onUpdate: () => (el.textContent = o.v.toFixed(decimals)),
        scrollTrigger: { trigger: el, start: "top 85%", once: true },
      });
    });

    // Photo opens from the bottom and drifts inside its frame.
    const frame = document.querySelector<HTMLElement>("[data-clip]")!;
    gsap.fromTo(
      frame,
      { clipPath: "inset(100% 0 0 0)" },
      {
        clipPath: "inset(0% 0 0 0)",
        duration: 1.4,
        ease: "expo.inOut",
        scrollTrigger: { trigger: frame, start: "top 85%", once: true },
      },
    );
    gsap.fromTo(
      "[data-parallax-img]",
      { yPercent: -12 },
      { yPercent: 0, ease: "none", scrollTrigger: { trigger: frame, start: "top bottom", end: "bottom top", scrub: true } },
    );

    // Stack tiles rise in, row by row.
    const stk = document.querySelector<HTMLElement>(".stk")!;
    gsap.from(stk.querySelectorAll("[data-tile]"), {
      y: 24,
      opacity: 0,
      duration: 0.8,
      ease: "expo.out",
      stagger: { each: 0.03, grid: "auto", from: "start" },
      scrollTrigger: { trigger: stk, start: "top 75%", once: true },
      // Hand opacity back to CSS so the tabs can dim tiles afterwards.
      clearProps: "opacity,transform",
    });
  }

  // Tabs dim the other groups in place, so the grid never reflows.
  const wall = document.querySelector<HTMLElement>("[data-wall]")!;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-stk-tab]")];
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      wall.dataset.active = tab.dataset.stkTab;
      tabs.forEach((t) => t.setAttribute("aria-pressed", String(t === tab)));
    }),
  );
</script>
