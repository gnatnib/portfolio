---
// The gnatnib mark from the previous site: a slanted slab with two cuts.
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
---

<span class:list={["logo", className]} style={`--s:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 360 226" fill="none">
    <path d="M40 200L120 20H320L240 200H40Z" fill="currentColor"></path>
    <path d="M135 170L200 50H250L185 170H135Z" fill="var(--bg)"></path>
    <path d="M80 170L110 110H140L110 170H80Z" fill="var(--bg)"></path>
  </svg>
</span>

<style>
  .logo {
    width: var(--s);
    height: var(--s);
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--rule-strong);
    flex: none;
    transition: border-color 0.25s var(--ease);
  }
  .logo svg {
    width: calc(var(--s) - 10px);
    height: auto;
  }
</style>
