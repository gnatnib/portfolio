---
import { siSpotify } from "simple-icons";
---

<div class="sp" data-spotify aria-label="Listening on Spotify">
  <a class="sp-now" data-sp-link target="_blank" rel="noopener">
    <span class="sp-record" aria-hidden="true">
      <span class="sp-disc"></span>
      <img alt="" data-sp-cover width="64" height="64" />
    </span>
    <span class="sp-text">
      <span class="sp-status mono">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siSpotify.path}></path></svg>
        <span data-sp-status>Spotify</span>
        <span class="sp-eq" aria-hidden="true"><i></i><i></i><i></i></span>
      </span>
      <span class="sp-title" data-sp-title></span>
      <span class="sp-artist muted" data-sp-artist></span>
    </span>
  </a>

  <div class="sp-repeat">
    <span class="mono muted">On repeat</span>
    <ul class="sp-stack" data-sp-tracks></ul>
  </div>
</div>

<style>
  .sp {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    flex-wrap: wrap;
    padding-block: 18px;
    border-block: 1px solid var(--rule);
  }
  html:not(.js) .sp,
  .sp.is-off {
    display: none;
  }

  .sp-now {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
    flex: 1 1 320px;
  }
  /* Cover with a record peeking out; the record spins while something plays. */
  .sp-record {
    position: relative;
    width: 64px;
    height: 64px;
    flex: none;
    margin-right: 18px;
  }
  .sp-record img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 64px;
    height: 64px;
    object-fit: cover;
    background: var(--panel);
  }
  .sp-disc {
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--accent) 0 16%, #0c0c0b 17% 19%, transparent 20%),
      repeating-radial-gradient(circle, #34342f 0 1px, #22221f 1px 2px);
    transform: translateX(30%);
    transition: transform 0.6s var(--ease);
  }
  .sp-now:hover .sp-disc {
    transform: translateX(42%);
  }
  .sp.is-playing .sp-disc {
    animation: spin 2.8s linear infinite;
  }
  @keyframes spin {
    from {
      transform: translateX(30%) rotate(0deg);
    }
    to {
      transform: translateX(30%) rotate(360deg);
    }
  }

  .sp-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .sp-status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 2px;
  }
  .sp-status svg {
    width: 14px;
    height: 14px;
    fill: #1ed760;
  }
  .sp-eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }
  .sp.is-playing .sp-eq {
    display: inline-flex;
  }
  .sp-eq i {
    width: 2px;
    height: 100%;
    background: #1ed760;
    transform-origin: bottom;
    animation: eq 0.9s ease-in-out infinite;
  }
  .sp-eq i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .sp-eq i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .sp-title {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.25s var(--ease);
  }
  .sp-now:hover .sp-title {
    color: #1ed760;
  }
  .sp-artist {
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sp-repeat {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  /* Overlapping covers that fan out when the row is hovered. */
  .sp-stack {
    display: flex;
    padding-left: 14px;
  }
  .sp-stack :global(li) {
    margin-left: -14px;
    transition:
      margin 0.45s var(--ease),
      transform 0.45s var(--ease);
  }
  .sp-repeat:hover .sp-stack :global(li),
  .sp-repeat:focus-within .sp-stack :global(li) {
    margin-left: 4px;
  }
  .sp-stack :global(li:hover) {
    transform: translateY(-4px);
  }
  .sp-stack :global(a) {
    display: block;
    width: 40px;
    height: 40px;
    border: 2px solid var(--bg);
    background: var(--panel);
  }
  .sp-stack :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .sp.is-playing .sp-disc {
      animation: none;
    }
  }
</style>

<script>
  type Track = { title: string; artist: string; album: string; image: string; url: string };
  type Data = {
    playing: boolean;
    current: (Track & { playedAt?: string }) | null;
    topTracks: Track[];
  };

  const root = document.querySelector<HTMLElement>("[data-spotify]")!;
  const link = root.querySelector<HTMLAnchorElement>("[data-sp-link]")!;
  const cover = root.querySelector<HTMLImageElement>("[data-sp-cover]")!;
  const status = root.querySelector<HTMLElement>("[data-sp-status]")!;
  const title = root.querySelector<HTMLElement>("[data-sp-title]")!;
  const artist = root.querySelector<HTMLElement>("[data-sp-artist]")!;
  const stack = root.querySelector<HTMLElement>("[data-sp-tracks]")!;

  const ago = (iso: string) => {
    const m = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
    if (m < 60) return `${Math.max(1, m)} min ago`;
    if (m < 1440) return `${Math.round(m / 60)} h ago`;
    return `${Math.round(m / 1440)} d ago`;
  };

  function render(d: Data) {
    const c = d.current;
    if (!c) throw new Error("nothing to show");
    root.classList.toggle("is-playing", d.playing);
    link.href = c.url;
    link.setAttribute("aria-label", `${c.title} by ${c.artist}, on Spotify`);
    if (cover.src !== c.image) cover.src = c.image;
    status.textContent = d.playing ? "Now playing" : c.playedAt ? `Last played, ${ago(c.playedAt)}` : "Last played";
    title.textContent = c.title;
    artist.textContent = c.artist;
    // DOM calls rather than innerHTML: titles come from Spotify.
    stack.replaceChildren(
      ...d.topTracks.slice(0, 8).map((t) => {
        const li = document.createElement("li");
        const a = Object.assign(document.createElement("a"), {
          href: t.url,
          target: "_blank",
          rel: "noopener",
          title: `${t.title}, ${t.artist}`,
        });
        a.setAttribute("aria-label", `${t.title} by ${t.artist}`);
        a.append(Object.assign(document.createElement("img"), { src: t.image, alt: "", loading: "lazy", width: 40, height: 40 }));
        li.append(a);
        return li;
      }),
    );
  }

  let visible = false;
  async function load() {
    try {
      const res = await fetch("/api/spotify");
      if (!res.ok) throw new Error(String(res.status));
      render(await res.json());
      root.classList.remove("is-off");
    } catch {
      // No credentials, Spotify down, or nothing played yet: hide the strip.
      root.classList.add("is-off");
    }
  }

  root.classList.add("is-off");
  new IntersectionObserver(([e]) => (visible = e.isIntersecting), { rootMargin: "200px" }).observe(root);
  load();
  // The edge caches for 30 s, so polling faster would only re-read the cache.
  setInterval(() => visible && !document.hidden && load(), 30_000);
</script>
