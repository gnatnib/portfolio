---
import { siSpotify } from "simple-icons";
---

<section id="spotify" class="sec wrap sp" data-tone="dark" data-label="Spotify" tabindex="-1" data-spotify>
  <header class="sec-head">
    <p class="sec-index mono">(05) Spotify</p>
    <h2 class="sec-title" data-reveal="lines">On repeat</h2>
  </header>

  <div class="sp-now" data-sp-now>
    <div class="sp-record" data-sp-record>
      <div class="sp-disc" aria-hidden="true"><span></span></div>
      <a class="sp-sleeve" data-sp-link target="_blank" rel="noopener" aria-label="Open the track on Spotify">
        <img alt="" data-sp-cover width="300" height="300" />
      </a>
    </div>

    <div class="sp-info">
      <p class="sp-status mono">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siSpotify.path}></path></svg>
        <span data-sp-status>Checking Spotify</span>
        <span class="sp-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </p>
      <h3 class="sp-title" data-sp-title><span class="sp-skel"></span></h3>
      <p class="sp-artist" data-sp-artist></p>
      <p class="sp-album mono muted" data-sp-album></p>
      <div class="sp-progress" aria-hidden="true"><span data-sp-progress></span></div>
    </div>
  </div>

  <div class="sp-lists">
    <div>
      <h3 class="mono muted sp-h">Top tracks, last four weeks</h3>
      <ol class="sp-tracks" data-sp-tracks></ol>
    </div>
    <div>
      <h3 class="mono muted sp-h">Top artists</h3>
      <ul class="sp-artists" data-sp-artists></ul>
    </div>
  </div>
</section>

<style>
  .sp {
    padding-bottom: clamp(96px, 12vw, 180px);
  }
  html:not(.js) .sp {
    display: none;
  }
  .sp.is-off {
    display: none;
  }

  .sp-now {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 32px;
    align-items: center;
    padding-top: clamp(40px, 5vw, 72px);
  }

  /* Album sleeve with the record sliding out of it; the record spins while
     something is playing. */
  .sp-record {
    grid-column: 1 / span 5;
    position: relative;
    aspect-ratio: 1 / 1;
    width: 78%;
  }
  .sp-sleeve {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--panel);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }
  .sp-sleeve img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .sp-sleeve img.is-loaded {
    opacity: 1;
  }
  .sp-disc {
    position: absolute;
    inset: 2%;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--accent) 0 14%, #0c0c0b 14.5% 16%, transparent 16.5%),
      repeating-radial-gradient(circle, #34342f 0 2px, #22221f 2px 4px);
    box-shadow: inset 0 0 0 1px rgb(236 234 228 / 0.12);
    transform: translateX(0);
    transition: transform 1.1s var(--ease);
  }
  .sp-disc span {
    position: absolute;
    inset: 48%;
    border-radius: 50%;
    background: var(--ink);
  }
  .sp.is-ready .sp-disc {
    transform: translateX(34%);
  }
  .sp.is-playing .sp-disc {
    animation: spin 3.2s linear infinite;
  }
  @keyframes spin {
    from {
      transform: translateX(34%) rotate(0deg);
    }
    to {
      transform: translateX(34%) rotate(360deg);
    }
  }

  .sp-info {
    grid-column: 6 / span 7;
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .sp-status {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sp-status svg {
    width: 18px;
    height: 18px;
    fill: #1ed760;
  }
  .sp-eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }
  .sp.is-playing .sp-eq {
    display: inline-flex;
  }
  .sp-eq i {
    width: 3px;
    height: 100%;
    background: #1ed760;
    transform-origin: bottom;
    animation: eq 0.9s ease-in-out infinite;
  }
  .sp-eq i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .sp-eq i:nth-child(3) {
    animation-delay: 0.3s;
  }
  .sp-eq i:nth-child(4) {
    animation-delay: 0.45s;
  }
  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.25);
    }
    50% {
      transform: scaleY(1);
    }
  }
  .sp-title {
    font-size: clamp(36px, 5.4vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sp-title a:hover {
    color: #1ed760;
  }
  .sp-artist {
    font-size: clamp(18px, 1.6vw, 24px);
  }
  .sp-progress {
    height: 2px;
    background: var(--rule);
    margin-top: 8px;
    max-width: 520px;
    visibility: hidden;
  }
  .sp.is-playing .sp-progress {
    visibility: visible;
  }
  .sp-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: #1ed760;
  }
  .sp-skel {
    display: block;
    width: 60%;
    height: 0.8em;
    background: var(--panel);
  }

  .sp-lists {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 64px);
    padding-top: clamp(64px, 8vw, 120px);
  }
  .sp-h {
    font-weight: 400;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .sp-tracks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gap);
  }
  .sp-tracks :global(a),
  .sp-artists :global(a) {
    display: grid;
    align-items: center;
    gap: 14px;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
    min-width: 0;
  }
  .sp-tracks :global(a) {
    grid-template-columns: 22px 48px minmax(0, 1fr);
  }
  .sp-artists :global(a) {
    grid-template-columns: 48px minmax(0, 1fr);
  }
  .sp-tracks :global(img),
  .sp-artists :global(img) {
    width: 48px;
    height: 48px;
    object-fit: cover;
    background: var(--panel);
    transition: transform 0.4s var(--ease);
  }
  .sp-artists :global(img) {
    border-radius: 50%;
  }
  .sp-tracks :global(a:hover img),
  .sp-artists :global(a:hover img) {
    transform: scale(1.08) rotate(-3deg);
  }
  .sp-lists :global(.t) {
    display: block;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sp-lists :global(.s) {
    display: block;
    font-size: 13px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sp-lists :global(a:hover .t) {
    color: #1ed760;
  }

  @media (max-width: 860px) {
    .sp-record {
      grid-column: 1 / span 9;
      width: 70%;
    }
    .sp-info,
    .sp-lists {
      grid-column: 1 / -1;
    }
    .sp-lists,
    .sp-tracks {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sp.is-playing .sp-disc {
      animation: none;
      transform: translateX(34%);
    }
  }
</style>

<script>
  import { ScrollTrigger } from "../scripts/motion";

  type Track = { title: string; artist: string; album: string; image: string; url: string };
  type Data = {
    playing: boolean;
    current: (Track & { progress?: number; duration?: number; playedAt?: string }) | null;
    topTracks: Track[];
    topArtists: { name: string; image: string; url: string; genre: string | null }[];
  };

  const root = document.querySelector<HTMLElement>("[data-spotify]")!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const cover = $<HTMLImageElement>("[data-sp-cover]");
  const link = $<HTMLAnchorElement>("[data-sp-link]");
  const status = $("[data-sp-status]");
  const title = $("[data-sp-title]");
  const artist = $("[data-sp-artist]");
  const album = $("[data-sp-album]");
  const progress = $("[data-sp-progress]");
  const tracks = $("[data-sp-tracks]");
  const artists = $("[data-sp-artists]");

  const ago = (iso: string) => {
    const m = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
    if (m < 60) return `${Math.max(1, m)} min ago`;
    if (m < 1440) return `${Math.round(m / 60)} h ago`;
    return `${Math.round(m / 1440)} d ago`;
  };

  // Built with DOM calls, not innerHTML: titles come from Spotify.
  function row(href: string, image: string, main: string, sub: string, index?: number) {
    const li = document.createElement("li");
    const a = Object.assign(document.createElement("a"), { href, target: "_blank", rel: "noopener" });
    if (index !== undefined) a.append(Object.assign(document.createElement("span"), { className: "mono muted", textContent: String(index).padStart(2, "0") }));
    a.append(Object.assign(document.createElement("img"), { src: image, alt: "", loading: "lazy", width: 48, height: 48 }));
    const text = document.createElement("span");
    text.append(
      Object.assign(document.createElement("span"), { className: "t", textContent: main }),
      Object.assign(document.createElement("span"), { className: "s", textContent: sub }),
    );
    a.append(text);
    li.append(a);
    return li;
  }

  let tick = 0;
  function render(d: Data) {
    const c = d.current;
    root.classList.toggle("is-playing", d.playing);
    root.classList.add("is-ready");
    if (c) {
      if (cover.src !== c.image) {
        cover.classList.remove("is-loaded");
        cover.onload = () => cover.classList.add("is-loaded");
        cover.src = c.image;
        cover.alt = `${c.album} cover`;
      }
      link.href = c.url;
      title.replaceChildren(Object.assign(document.createElement("a"), { href: c.url, target: "_blank", rel: "noopener", textContent: c.title }));
      artist.textContent = c.artist;
      album.textContent = c.album;
      status.textContent = d.playing ? "Now playing" : c.playedAt ? `Last played, ${ago(c.playedAt)}` : "Last played";
    } else {
      title.textContent = "Nothing playing";
      status.textContent = "Spotify";
    }

    // Move the progress bar locally between polls.
    clearInterval(tick);
    if (d.playing && c?.duration) {
      const start = Date.now() - (c.progress ?? 0);
      const paint = () => (progress.style.width = `${Math.min(100, ((Date.now() - start) / c.duration!) * 100)}%`);
      paint();
      tick = window.setInterval(paint, 1000);
    }

    tracks.replaceChildren(...d.topTracks.map((t, i) => row(t.url, t.image, t.title, t.artist, i + 1)));
    artists.replaceChildren(...d.topArtists.map((a) => row(a.url, a.image, a.name, a.genre ?? "Artist")));
  }

  let visible = false;
  async function load() {
    try {
      const res = await fetch("/api/spotify");
      if (!res.ok) throw new Error(String(res.status));
      render(await res.json());
    } catch {
      // No credentials or Spotify is down: drop the section rather than show a broken box.
      if (!root.classList.contains("is-ready")) {
        root.classList.add("is-off");
        ScrollTrigger.refresh();
      }
    }
  }

  new IntersectionObserver(([e]) => (visible = e.isIntersecting), { rootMargin: "200px" }).observe(root);
  load();
  // The edge caches for 30 s, so polling faster would only re-read the cache.
  setInterval(() => visible && !document.hidden && load(), 30_000);
</script>
