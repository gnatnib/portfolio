---
import { Image, getImage } from "astro:assets";
import photo from "../assets/portrait-photo.jpg";
import closeup from "../assets/portrait-closeup.png";

// The ASCII is drawn from a close-up (head and shoulders, background removed)
// so the face reads in characters. 240px wide is more detail than the densest
// grid (96 columns) can show.
const mask = await getImage({ src: closeup, width: 240, format: "png" });

// Where the close-up sits inside the photo, as fractions of the photo. Both
// were cut from the same 2268x4032 original: the photo is x 0..2268,
// y 900..3924; the close-up is x 835..1735, y 1400..2600. Until developed, the
// photo is zoomed onto this region; developing zooms out to the whole photo.
const crop = [835 / 2268, (1400 - 900) / 3024, 900 / 2268, 1200 / 3024].map((n) => n.toFixed(4)).join(",");
---

<figure class="ap" data-ascii data-mask={mask.src} data-crop={crop} data-photo-ratio={photo.width / photo.height}>
  <div class="ap-frame" data-ascii-frame>
    <Image
      src={photo}
      alt="Bintang Syafrian Rizal in a batik shirt, standing on a street in Jakarta"
      widths={[360, 540, 720, 900]}
      sizes="(max-width: 860px) 92vw, 34vw"
      loading="eager"
      fetchpriority="high"
      class="ap-photo"
    />
    <canvas class="ap-canvas" aria-hidden="true" data-ascii-canvas></canvas>
    <span class="ap-tick tl" aria-hidden="true"></span>
    <span class="ap-tick br" aria-hidden="true"></span>
  </div>
  <figcaption class="ap-cap">
    <button class="mono ap-btn" type="button" data-ascii-toggle aria-pressed="false" data-magnetic>Show photo</button>
  </figcaption>
</figure>

<style>
  .ap {
    position: relative;
  }
  .ap-frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--panel);
    cursor: crosshair;
    touch-action: pan-y;
  }
  .ap-photo,
  .ap-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  html.js .ap-photo {
    visibility: hidden;
  }
  html.js .ap.is-live .ap-photo {
    visibility: visible;
  }
  /* --zoom-t is set by scripts/ascii.ts from the same geometry the characters
     are sampled with, so the photo under the lens matches them exactly.
     Developing clears it and the full photo shows. */
  html.js .ap-photo {
    transform-origin: 0 0;
    transform: var(--zoom-t, none);
    transition: transform 1.3s var(--ease);
  }
  html.js .ap.is-developed .ap-photo {
    transform: translate(0, 0) scale(1);
  }
  .ap-tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--fg);
    pointer-events: none;
    z-index: 2;
  }
  .ap-tick.tl {
    top: 8px;
    left: 8px;
    border-width: 1px 0 0 1px;
  }
  .ap-tick.br {
    right: 8px;
    bottom: 8px;
    border-width: 0 1px 1px 0;
  }
  .ap-cap {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    padding-top: 10px;
  }
  .ap-btn {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .ap-btn:hover {
    background: var(--fg);
    color: var(--bg);
  }
  html:not(.js) .ap-cap {
    display: none;
  }
</style>

<script>
  import { mountAsciiPortrait } from "../scripts/ascii";
  document.querySelectorAll<HTMLElement>("[data-ascii]").forEach(mountAsciiPortrait);
</script>
