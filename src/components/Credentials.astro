---
import { getImage } from "astro:assets";
import { certificateGroups } from "../data";

const items = await Promise.all(
  certificateGroups.flatMap((g) =>
    g.items.map(async (item) => {
      const [thumb, full] = await Promise.all([
        getImage({ src: item.image, width: 480, format: "webp" }),
        getImage({ src: item.image, width: Math.min(1600, item.image.width), format: "webp" }),
      ]);
      return {
        issuer: g.issuer,
        title: item.title,
        thumb: thumb.src,
        full: full.src,
        w: full.attributes.width,
        h: full.attributes.height,
      };
    }),
  ),
);
const total = items.length;
const breakdown = certificateGroups.map((g) => ({ issuer: g.issuer, n: g.items.length }));
const maxN = Math.max(...breakdown.map((b) => b.n));
// Alternate items between the two rows so each row mixes issuers.
const rowsOf = [items.filter((_, i) => i % 2 === 0), items.filter((_, i) => i % 2 === 1)];
---

<section id="credentials" class="sec cr" data-tone="light" data-label="Credentials" tabindex="-1">
  <header class="sec-head wrap">
    <p class="sec-index mono">(05) Credentials</p>
    <h2 class="sec-title" data-reveal="lines">Certificates<sup>({total})</sup></h2>
  </header>

  <div class="cr-bar wrap" aria-label="Certificates by issuer">
    <div class="cr-stack">
      {
        breakdown.map((b) => (
          <span class="cr-seg" style={`flex:${b.n};--n:${((b.n / maxN) * 100).toFixed(1)}`} data-cr-seg>
            <span class="cr-seg-fill" />
            <span class="cr-seg-label">
              <span class="num">{b.n}</span> <span class="mono muted">{b.issuer}</span>
            </span>
          </span>
        ))
      }
    </div>
  </div>

  <div class="cr-rows" data-cr-rows>
    {
      rowsOf.map((row, r) => (
        <div class="cr-row" data-cr-row data-dir={r === 0 ? -1 : 1}>
          <ul class="cr-track" data-cr-track>
            {[...row, ...row].map((c, i) => (
              <li aria-hidden={i >= row.length ? "true" : undefined}>
                <button
                  type="button"
                  class="cr-card"
                  data-cert={c.full}
                  data-w={c.w}
                  data-h={c.h}
                  data-title={c.title}
                  tabindex={i >= row.length ? -1 : undefined}
                >
                  <img src={c.thumb} alt="" loading="lazy" decoding="async" width="480" height="360" />
                  <span class="cr-cap">
                    <span class="mono muted">{c.issuer}</span>
                    <span class="cr-title">{c.title}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <dialog class="cr-dialog" data-cert-dialog aria-label="Certificate">
    <form method="dialog" class="cr-dialog-bar">
      <p class="mono" data-cert-title></p>
      <button class="mono cr-close" value="close">Close</button>
    </form>
    <img alt="" data-cert-img />
  </dialog>
</section>

<style>
  .cr {
    padding-bottom: 0;
  }
  .cr-bar {
    padding-top: clamp(28px, 3vw, 44px);
  }
  .cr-stack {
    display: flex;
    gap: 4px;
  }
  .cr-seg {
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  .cr-seg-fill {
    height: 14px;
    border-radius: 7px;
    background: var(--fg);
    transform-origin: 0 50%;
  }
  .cr-seg:first-child .cr-seg-fill {
    background: var(--accent);
  }
  .cr-seg-label {
    font-size: 15px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cr-seg-label .num {
    font-size: 22px;
    letter-spacing: -0.03em;
  }

  .cr-rows {
    display: grid;
    gap: 16px;
    padding-top: clamp(40px, 5vw, 72px);
    overflow: hidden;
  }
  .cr-row {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cr-row::-webkit-scrollbar {
    display: none;
  }
  html.motion .cr-row {
    overflow: visible;
  }
  .cr-track {
    display: flex;
    gap: 16px;
    width: max-content;
    padding-inline: var(--pad);
  }
  .cr-card {
    display: grid;
    gap: 10px;
    width: clamp(220px, 21vw, 300px);
    text-align: left;
  }
  .cr-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: #fff;
    border: 1px solid var(--rule);
    transition: transform 0.5s var(--ease);
  }
  .cr-card:hover img,
  .cr-card:focus-visible img {
    transform: translateY(-6px) rotate(-1deg);
  }
  .cr-cap {
    display: grid;
    gap: 2px;
  }
  .cr-title {
    font-size: 14px;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cr-dialog {
    width: min(1100px, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--paper);
  }
  .cr-dialog::backdrop {
    background: rgb(19 19 17 / 0.7);
  }
  .cr-dialog-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 8px 8px 8px 16px;
  }
  .cr-close {
    min-height: 40px;
    padding-inline: 14px;
    border: 1px solid rgb(236 234 228 / 0.3);
    border-radius: 999px;
  }
  .cr-dialog img {
    width: 100%;
    height: auto;
    max-height: calc(92vh - 56px);
    object-fit: contain;
    background: #fff;
  }

  @media (max-width: 860px) {
    .cr-stack {
      flex-direction: column;
      gap: 12px;
    }
    .cr-seg {
      grid-template-columns: 1fr auto;
      align-items: center;
      flex: none !important;
    }
    .cr-seg-fill {
      width: calc(var(--n) * 1%);
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from "../scripts/motion";

  const dialog = document.querySelector<HTMLDialogElement>("[data-cert-dialog]")!;
  const img = dialog.querySelector<HTMLImageElement>("[data-cert-img]")!;
  const title = dialog.querySelector<HTMLElement>("[data-cert-title]")!;

  document.querySelectorAll<HTMLButtonElement>("[data-cert]").forEach((btn) => {
    btn.addEventListener("click", () => {
      img.src = btn.dataset.cert!;
      img.width = Number(btn.dataset.w);
      img.height = Number(btn.dataset.h);
      img.alt = `Certificate: ${btn.dataset.title}`;
      title.textContent = btn.dataset.title!;
      dialog.showModal();
      window.dispatchEvent(new Event("lenis:stop"));
    });
  });
  dialog.addEventListener("close", () => window.dispatchEvent(new Event("lenis:start")));
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  if (!reduced) {
    gsap.from("[data-cr-seg] .cr-seg-fill", {
      scaleX: 0,
      duration: 1.2,
      ease: "expo.out",
      stagger: 0.1,
      scrollTrigger: { trigger: "[data-cr-seg]", start: "top 85%", once: true },
    });

    /* Two rows drift in opposite directions. Scrolling speeds them up, hovering
       a row slows it to a stop so a card can be picked. */
    const rows = [...document.querySelectorAll<HTMLElement>("[data-cr-row]")];
    const state = rows.map((row) => ({
      row,
      track: row.querySelector<HTMLElement>("[data-cr-track]")!,
      dir: Number(row.dataset.dir),
      x: 0,
      hover: 0,
      hovering: false,
    }));
    state.forEach((s) => {
      s.row.addEventListener("pointerenter", () => (s.hovering = true));
      s.row.addEventListener("pointerleave", () => (s.hovering = false));
    });

    let boost = 0;
    let visible = false;
    ScrollTrigger.create({
      trigger: "[data-cr-rows]",
      start: "top bottom",
      end: "bottom top",
      onToggle: (self) => (visible = self.isActive),
      onUpdate: (self) => (boost = Math.min(8, Math.abs(self.getVelocity()) / 300)),
    });

    gsap.ticker.add((_, delta) => {
      if (!visible) return;
      boost *= 0.92;
      for (const s of state) {
        s.hover += ((s.hovering ? 1 : 0) - s.hover) * 0.1;
        const half = s.track.scrollWidth / 2;
        s.x += s.dir * (0.04 + boost * 0.12) * (1 - s.hover) * delta;
        if (s.x <= -half) s.x += half;
        if (s.x > 0) s.x -= half;
        s.track.style.transform = `translate3d(${s.x}px,0,0)`;
      }
    });
  }
</script>
