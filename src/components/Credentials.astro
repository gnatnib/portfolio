---
import { Image, getImage } from "astro:assets";
import { certificateGroups, resumeUrl, resume } from "../data";
import cvPage from "../assets/cv/page-1.png";

const groups = await Promise.all(
  certificateGroups.map(async (g) => ({
    issuer: g.issuer,
    items: await Promise.all(
      g.items.map(async (item) => {
        const img = await getImage({ src: item.image, width: Math.min(1600, item.image.width), format: "webp" });
        return { title: item.title, src: img.src, w: img.attributes.width, h: img.attributes.height };
      }),
    ),
  })),
);
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

<section id="credentials" class="sec wrap" data-tone="light" data-label="Credentials" tabindex="-1">
  <header class="sec-head">
    <p class="sec-index mono">(05) Credentials</p>
    <h2 class="sec-title" data-reveal="lines">Certificates<sup>({total})</sup></h2>
  </header>

  <div class="cr">
    <div class="cr-groups">
      {
        groups.map((g) => (
          <div class="cr-group">
            <h3 class="cr-issuer">
              {g.issuer}
              <span class="mono muted num">{String(g.items.length).padStart(2, "0")}</span>
            </h3>
            <ul>
              {g.items.map((item) => (
                <li>
                  <button type="button" class="cr-item" data-cert={item.src} data-w={item.w} data-h={item.h}>
                    <span>{item.title}</span>
                    <span class="mono muted cr-view" aria-hidden="true">View</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <aside class="cr-cv">
      <a href="/resume" class="cr-cv-page" aria-label="Read the resume">
        <Image src={cvPage} alt="" widths={[360, 540, 720]} sizes="(max-width: 860px) 70vw, 24vw" loading="lazy" />
      </a>
      <div class="cr-cv-links">
        <a href="/resume" class="ul ul-on">Read the resume</a>
        <a href={resumeUrl} download={resume.downloadName} class="ul">Download PDF</a>
      </div>
    </aside>
  </div>

  <dialog class="cr-dialog" data-cert-dialog aria-label="Certificate">
    <form method="dialog" class="cr-dialog-bar">
      <p class="mono" data-cert-title></p>
      <button class="mono cr-close" value="close">Close</button>
    </form>
    <img alt="" data-cert-img />
  </dialog>
</section>

<style>
  .cr {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    padding-top: clamp(32px, 4vw, 56px);
  }
  .cr-groups {
    grid-column: 1 / span 8;
    columns: 2;
    column-gap: var(--gap);
  }
  .cr-group {
    break-inside: avoid;
    margin-bottom: 40px;
  }
  .cr-issuer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.015em;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .cr-item {
    width: 100%;
    min-height: 44px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    text-align: left;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
    line-height: 1.35;
    transition: padding 0.35s var(--ease);
  }
  .cr-view {
    opacity: 0;
    transition: opacity 0.25s;
  }
  .cr-item:hover,
  .cr-item:focus-visible {
    padding-inline-start: 10px;
  }
  .cr-item:hover .cr-view,
  .cr-item:focus-visible .cr-view {
    opacity: 1;
  }
  .cr-cv {
    grid-column: 10 / span 3;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }
  .cr-cv-page {
    display: block;
    border: 1px solid var(--rule);
    transition: transform 0.5s var(--ease);
  }
  .cr-cv-page:hover {
    transform: rotate(-1.5deg) translateY(-4px);
  }
  .cr-cv-links {
    display: flex;
    gap: 20px;
    padding-top: 14px;
    font-size: 15px;
  }

  .cr-dialog {
    width: min(1100px, 94vw);
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: var(--ink);
    color: var(--paper);
  }
  .cr-dialog::backdrop {
    background: rgb(19 19 17 / 0.7);
  }
  .cr-dialog-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 8px 8px 8px 16px;
  }
  .cr-close {
    min-height: 40px;
    padding-inline: 14px;
    border: 1px solid rgb(236 234 228 / 0.3);
    border-radius: 999px;
  }
  .cr-dialog img {
    width: 100%;
    height: auto;
    max-height: calc(92vh - 56px);
    object-fit: contain;
    background: #fff;
  }

  @media (max-width: 860px) {
    .cr-groups {
      grid-column: 1 / -1;
      columns: 1;
    }
    .cr-cv {
      grid-column: 1 / span 9;
      position: static;
      margin-top: 16px;
    }
    .cr-view {
      opacity: 1;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-cert-dialog]")!;
  const img = dialog.querySelector<HTMLImageElement>("[data-cert-img]")!;
  const title = dialog.querySelector<HTMLElement>("[data-cert-title]")!;

  document.querySelectorAll<HTMLButtonElement>("[data-cert]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const name = btn.querySelector("span")!.textContent!;
      img.src = btn.dataset.cert!;
      img.width = Number(btn.dataset.w);
      img.height = Number(btn.dataset.h);
      img.alt = `Certificate: ${name}`;
      title.textContent = name;
      dialog.showModal();
      window.dispatchEvent(new Event("lenis:stop"));
    });
  });
  dialog.addEventListener("close", () => window.dispatchEvent(new Event("lenis:start")));
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
