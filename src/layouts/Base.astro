---
import "../styles/global.css";
import Header from "../components/Header.astro";
import portrait from "../assets/portrait-photo.jpg";
import { getImage } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  tone?: "light" | "dark";
}

const {
  title = "Bintang Syafrian Rizal, Software Engineer",
  description = "Software engineer at CIMB Niaga. Full-stack web applications and machine learning systems, from the database schema to the last screen.",
  tone = "light",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: portrait, width: 1200, format: "jpg" });
---

<!doctype html>
<html lang="en" data-tone={tone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#eceae4" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("motion");
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <slot name="after" />
  </body>
</html>
